import assert from 'node:assert/strict';
import {writeFileSync} from 'node:fs';
import {launchChromium} from './browser-launch.mts';
import {makeHarness} from './harness.mts';
const BASE=process.env.BASE;if(!BASE||process.env.TT89_DISPOSABLE_DATABASE!=='1')throw Error('Disposable target required');
const {test,finish}=makeHarness('e2e-tt105-clicked');
const api=async(method:string,path:string,body?:unknown)=>{const r=await fetch(BASE+path,{method,headers:{'content-type':'application/json'},body:body?JSON.stringify(body):undefined});const j=await r.json();assert.ok(r.ok,JSON.stringify(j));return j;};
const b=await launchChromium(),page=await b.newPage({viewport:{width:1440,height:1100}});page.setDefaultTimeout(15000);
try{
 await api('GET','/api/settings');const state=await api('GET','/api/state?id=default');const tag='clicked105-'+Date.now(),folder='/Downloads/Recall/'+tag;
 await api('PUT','/api/state',{id:'default',revision:(state.row?.revision??0)+100,state:{...state.row?.state,windows:[{id:'clicked105',module:'recall',title:'Recall',props:{url:'http://127.0.0.1:4002/',proxyAll:true},x:15,y:45,w:1380,h:970,z:20,workspace:1}],focus:'clicked105',nextZ:21,activeWorkspace:1}});await page.goto(BASE);
 const recall=page.getByTestId('recall');await recall.getByRole('button',{name:'Browse inside Recall',exact:true}).click();const pane=recall.getByRole('region',{name:'Recall browser',exact:true}),frame=pane.frameLocator('[data-testid=wp-frame]');await frame.getByRole('heading',{name:'Already viewed visual'}).waitFor();await pane.getByLabel('Auto Recall folders',{exact:true}).selectOption('custom');await pane.getByLabel('Auto Recall custom folder',{exact:true}).fill(tag);
 const list=async()=>((await api('GET','/api/fs?'+new URLSearchParams({op:'recallPage',path:folder}))).nodes as {path:string}[]);
 const save=async()=>{await pane.getByRole('button',{name:'Save clicked loaded visual',exact:true}).click();await pane.getByText('Saved loaded visual →',{exact:false}).waitFor();};
 await test('no pointer selection refuses without a largest fallback',{'RC-23':'partial'},async()=>{await pane.getByRole('button',{name:'Save clicked loaded visual',exact:true}).click();await pane.getByText('Not saved: Click a loaded image',{exact:false}).waitFor();assert.equal((await list()).length,0);});
 await frame.locator('canvas').evaluate((big:HTMLCanvasElement)=>{const small=document.createElement('canvas');small.id='small105';small.width=16;small.height=16;small.style.cssText='width:64px;height:64px';small.getContext('2d')!.fillStyle='blue';small.getContext('2d')!.fillRect(0,0,16,16);big.before(small);});
 await test('native pointer chooses smaller decoded canvas without asset refetch',{'RC-23':'partial'},async()=>{const before=await(await fetch('http://127.0.0.1:4002/count')).json();await frame.locator('#small105').click();await save();assert.deepEqual(await(await fetch('http://127.0.0.1:4002/count')).json(),before);const node=(await list())[0];const media=await api('GET','/api/fs?'+new URLSearchParams({op:'read',path:node.path}));const receipt=await api('GET','/api/fs?'+new URLSearchParams({op:'read',path:node.path+'.recall.json'}));assert.equal(JSON.parse(receipt.node.content).method,'clicked-visual-png');assert.equal(await page.evaluate(async(content:string)=>{const raw=atob(content);const image=await createImageBitmap(new Blob([Uint8Array.from(raw,c=>c.charCodeAt(0))],{type:'image/png'}));const c=document.createElement('canvas');c.width=1;c.height=1;const x=c.getContext('2d')!;x.drawImage(image,0,0);image.close();return Array.from(x.getImageData(0,0,1,1).data).join(',');},media.node.content),'0,0,255,255');});
 await test('selected connected target beyond first 200 visuals is still eligible',{},async()=>{await frame.locator('#small105').evaluate(target=>{for(let i=0;i<205;i++){const c=document.createElement('canvas');c.hidden=true;target.before(c);}});await frame.locator('#small105').click();const before=(await list()).length;await save();assert.equal((await list()).length,before+1);});
 await test('removed selected target refuses rather than saving another visual',{},async()=>{await frame.locator('#small105').evaluate(e=>e.remove());const before=(await list()).length;await pane.getByRole('button',{name:'Save clicked loaded visual',exact:true}).click();await pane.getByText('Not saved: Click a loaded image',{exact:false}).waitFor();assert.equal((await list()).length,before);});
 await test('a nonmedia native pointer action clears previous selection',{},async()=>{await frame.getByRole('heading',{name:'Already viewed visual'}).click();const before=(await list()).length;await pane.getByRole('button',{name:'Save clicked loaded visual',exact:true}).click();await pane.getByText('Not saved: Click a loaded image',{exact:false}).waitFor();assert.equal((await list()).length,before);});
 await test('clicked tainted canvas is refused without refetch fallback',{},async()=>{await frame.getByRole('button',{name:'Load opaque image'}).click();const big=frame.locator('canvas:not([hidden])');for(let i=0;i<100;i++){if(await big.evaluate((c:HTMLCanvasElement)=>{try{c.getContext('2d')!.getImageData(0,0,1,1);return false;}catch{return true;}}))break;await page.waitForTimeout(100);}assert.equal(await big.evaluate((c:HTMLCanvasElement)=>{try{c.toDataURL();return false;}catch{return true;}}),true);await big.click();const before=(await list()).length,counts=await(await fetch('http://127.0.0.1:4002/count')).json();await pane.getByRole('button',{name:'Save clicked loaded visual',exact:true}).click();await pane.getByText('Not saved:',{exact:false}).waitFor();assert.equal((await list()).length,before);assert.deepEqual(await(await fetch('http://127.0.0.1:4002/count')).json(),counts);});
 await test('Specs registers atomic and clicked workflows without full-grade inflation',{},async()=>{const rows=(await api('GET','/api/features')).rows.filter((r:{code:string})=>/^RC-\d\d$/.test(r.code));assert.equal(rows.length,23);assert.ok(rows.every((r:{status:string})=>r.status==='partial'));});
 await page.screenshot({path:'docs/evidence/tt105-clicked.png'});writeFileSync('docs/evidence/tt105-runtime.json',JSON.stringify({node:process.version,chromium:b.version(),agents:1,independentReviewer:false,theoremProver:false,physicalClipboardAudioDisplayVerified:false,newTestsSyntheticEvents:false,newTestsNetworkInterception:false,graphics:'real headless Chromium, software graphics'},null,2));
}finally{await b.close();}
finish();
