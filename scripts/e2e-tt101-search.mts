import assert from 'node:assert/strict';
import {readFileSync} from 'node:fs';
import {launchChromium} from './browser-launch.mts';
import {makeHarness} from './harness.mts';
if(process.env.TT89_DISPOSABLE_DATABASE!=='1'||!process.env.BASE||!process.env.DATABASE_URL)throw new Error('Explicit disposable server required');
const BASE=process.env.BASE,tag='tt101-ui-'+Date.now();
const {test,finish}=makeHarness('e2e-tt101-search');
async function api(method:string,path:string,body?:unknown){const r=await fetch(BASE+path,{method,headers:{'content-type':'application/json'},body:body?JSON.stringify(body):undefined});assert.ok(r.ok,await r.clone().text());return r.json();}
await api('POST','/api/fs',{op:'write',path:'/Documents/'+tag+'.json',content:JSON.stringify({transcript:'manganese spoken passage',lyrics:'<img src=x onerror=alert(1)> real lyric text'}),mime:'application/json'});
const old=await api('GET','/api/state?id=default');await api('PUT','/api/state',{id:'default',revision:(old.row?.revision??1)+1000,state:{...old.row?.state,windows:[],focus:null}});
const browser=await launchChromium();const page=await browser.newPage({viewport:{width:1440,height:1000}});const errors:string[]=[];page.on('pageerror',e=>errors.push(e.message));
try{
 await page.goto(BASE+'/?open=find');const win=page.locator('.fs-window[aria-label=Find]');await win.getByLabel('Search query',{exact:true}).waitFor();
 await test('real Find UI searches stored transcripts and renders field provenance',{},async()=>{await win.getByLabel('Search mode',{exact:true}).selectOption('metadata');await win.getByLabel('Scope',{exact:true}).fill('/Documents/'+tag+'.json');await win.getByLabel('Metadata field',{exact:true}).fill('transcript');await win.getByLabel('Search query',{exact:true}).fill('manganese');await win.getByRole('button',{name:'Search',exact:true}).click();await win.getByLabel('Matched metadata fields').filter({hasText:'content.transcript'}).waitFor();assert.ok((await win.textContent())?.includes('manganese spoken passage'));await page.screenshot({path:'docs/evidence/tt101-search.png'});});
 await test('hostile stored metadata is rendered as text, not injected HTML',{},async()=>{await win.getByLabel('Metadata field',{exact:true}).fill('lyrics');await win.getByLabel('Search query',{exact:true}).fill('real lyric text');await win.getByRole('button',{name:'Search',exact:true}).click();await win.getByLabel('Matched metadata fields').filter({hasText:'<img src=x onerror=alert(1)>'}).waitFor();assert.equal(await win.locator('img[src=x]').count(),0);});
 await test('query bound errors are visible, clear old hits, and allow a genuine retry',{},async()=>{await win.getByLabel('Search query',{exact:true}).fill('x'.repeat(513));await win.getByRole('button',{name:'Search',exact:true}).click();await win.getByRole('alert').filter({hasText:'512'}).waitFor();assert.equal(await win.getByLabel('Matched metadata fields').count(),0);await win.getByLabel('Metadata field',{exact:true}).fill('transcript');await win.getByLabel('Search query',{exact:true}).fill('manganese');await win.getByRole('button',{name:'Search',exact:true}).click();await win.getByLabel('Matched metadata fields').filter({hasText:'content.transcript'}).waitFor();});
 await test('real UI traverses bounded pages instead of claiming no global matches',{},async()=>{const dir='/Documents/'+tag+'-pages';for(let i=0;i<35;i++)await api('POST','/api/fs',{op:'write',path:dir+'/'+String(i).padStart(2,'0')+'.txt',content:i===34?'paginationuisentinel':'ordinary',mime:'text/plain'});await win.getByLabel('Scope',{exact:true}).fill(dir);await win.getByLabel('Metadata field',{exact:true}).fill('');await win.getByLabel('Search query',{exact:true}).fill('paginationuisentinel');await win.getByRole('button',{name:'Search',exact:true}).click();const next=win.getByRole('button',{name:'Search next metadata page',exact:true});await next.waitFor();await next.click();await win.getByLabel('Matched metadata fields').filter({hasText:'paginationuisentinel'}).waitFor();});
 await test('editing criteria after a paged query invalidates old cursors and old result provenance',{},async()=>{await win.getByLabel('Search query',{exact:true}).fill('different query');assert.equal(await win.getByRole('button',{name:'Search next metadata page',exact:true}).count(),0);assert.equal(await win.getByLabel('Matched metadata fields').count(),0);await win.getByLabel('Scope',{exact:true}).fill('/Privateer');await win.getByRole('button',{name:'/Private only',exact:true}).click();assert.equal(await win.getByLabel('Scope',{exact:true}).inputValue(),'/Private');});
 await test('locked private query runs in the real browser without sending query text to HTTP',{},async()=>{await win.getByLabel('Search mode',{exact:true}).selectOption('metadata');await win.getByLabel('Scope',{exact:true}).fill('/Private');await win.getByLabel('Search query',{exact:true}).fill('privatebrowserwitness');const requests:string[]=[];const observer=(request:import('playwright').Request)=>requests.push(request.url());page.on('request',observer);try{await win.getByRole('button',{name:'Search',exact:true}).click();await win.getByRole('alert').filter({hasText:'locked'}).waitFor();assert.ok(!requests.some(x=>x.includes('privatebrowserwitness')));}finally{page.off('request',observer);}});
 await test('metadata result UI passes external axe checks in the actual populated mode',{},async()=>{await win.getByLabel('Scope',{exact:true}).fill('/Documents/'+tag+'.json');await win.getByLabel('Metadata field',{exact:true}).fill('transcript');await win.getByLabel('Search query',{exact:true}).fill('manganese');await win.getByRole('button',{name:'Search',exact:true}).click();await win.getByLabel('Matched metadata fields').waitFor();await page.addScriptTag({content:readFileSync('node_modules/axe-core/axe.min.js','utf8')});const failures=await page.evaluate(async()=>{const result=await (window as unknown as {axe:{run:(node:Element)=>Promise<{violations:{id:string;impact:string}[]}>}}).axe.run(document.querySelector('.fs-window[aria-label=Find]')!);return result.violations.filter(v=>v.impact==='serious'||v.impact==='critical');});assert.deepEqual(failures,[]);await win.getByLabel('Matched metadata fields').scrollIntoViewIfNeeded();await page.screenshot({path:'docs/evidence/tt101-search-results.png'});});
 await test('switching modes clears old result and no-match claims until another search runs',{},async()=>{await win.getByLabel('Search mode',{exact:true}).selectOption('text');assert.equal(await win.getByLabel('Matched metadata fields').count(),0);assert.equal(await win.getByText('Results for: manganese',{exact:true}).count(),0);assert.equal(await win.getByText('No matches in returned results (check coverage/pages)',{exact:true}).count(),0);});
 await test('no uncaught page errors in actual search interactions',{},()=>assert.deepEqual(errors,[]));
}finally{await browser.close();}finish();
