import assert from 'node:assert/strict';
import {createHash,randomUUID} from 'node:crypto';
import pg from 'pg';
import {makeHarness} from './harness.mts';
const BASE=process.env.BASE,dsn=process.env.DATABASE_URL;
if(!BASE||!dsn||process.env.TT89_DISPOSABLE_DATABASE!=='1'||!new URL(dsn).pathname.endsWith('_test'))throw Error('Exclusive _test database required');
const {test,finish}=makeHarness('tt105-atomic'),pool=new pg.Pool({connectionString:dsn}),folder='/Downloads/Recall/atomic105-'+Date.now();
const api=async(body:unknown)=>{const r=await fetch(BASE+'/api/fs',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify(body)});return {status:r.status,data:await r.json()};};
const payload=(name=randomUUID())=>{const path=folder+'/'+name+'.png',bytes=Buffer.from([1,2,3,4]);return {op:'recallCommit',path,content:bytes.toString('base64'),mime:'image/png',receipt:JSON.stringify({version:1,path,bytes:bytes.length,sha256:createHash('sha256').update(bytes).digest('hex'),mime:'image/png',method:'human-selected-file',capturedAt:new Date().toISOString(),source:'https://example.com/media',page:'https://example.com/',queryRedacted:true})};};
const rows=async(path:string)=>(await pool.query('SELECT path,content,encoding,mime FROM vfs_nodes WHERE path=$1 OR path=$2 ORDER BY path',[path,path+'.recall.json'])).rows;
try{
 await fetch(BASE+'/api/settings');for(const path of ['/Downloads','/Downloads/Recall',folder])assert.equal((await api({op:'mkdir',path})).status,200);
 await test('one acknowledgement publishes both exact media and receipt',{'RC-22':'partial'},async()=>{const p=payload();assert.equal((await api(p)).status,200);const r=await rows(p.path);assert.equal(r.length,2);assert.equal(r[0].content,p.content);assert.equal(r[1].content,p.receipt);});
 await test('duplicate media path cannot overwrite existing pair',{},async()=>{const p=payload();assert.equal((await api(p)).status,200);const before=await rows(p.path);assert.equal((await api(p)).status,409);assert.deepEqual(await rows(p.path),before);});
 await test('pre-existing receipt rolls back media, index and journal',{},async()=>{const p=payload();assert.equal((await api({op:'write',path:p.path+'.recall.json',content:'existing'})).status,200);assert.equal((await api(p)).status,409);assert.equal((await rows(p.path)).length,1);assert.equal((await pool.query('SELECT 1 FROM index_docs WHERE ref=$1',[p.path])).rowCount,0);assert.equal((await pool.query('SELECT 1 FROM file_ops WHERE src=$1',[p.path])).rowCount,0);});
 await test('concurrent creates have one winner and no mixed pair',{},async()=>{const p=payload();const replies=await Promise.all(Array.from({length:8},()=>api(p)));assert.equal(replies.filter(r=>r.status===200).length,1);assert.ok(replies.every(r=>r.status===200||r.status===409));assert.equal((await rows(p.path)).length,2);});
 for(const [field,value] of Object.entries({version:2,path:'/elsewhere',bytes:3,sha256:'0'.repeat(64),mime:'image/jpeg',method:'<script>',capturedAt:'1',queryRedacted:false,source:'https://example.com/?secret=1',page:'https://example.com/#secret'}))await test('receipt validation before publication: '+field,{},async()=>{const p=payload();p.receipt=JSON.stringify({...JSON.parse(p.receipt),[field]:value});assert.equal((await api(p)).status,400);assert.equal((await rows(p.path)).length,0);});
 for(const content of ['','!!!!','AQIDBA','AQIDBA==='])await test('noncanonical or empty base64 '+content,{},async()=>{const p=payload();p.content=content;assert.equal((await api(p)).status,400);assert.equal((await rows(p.path)).length,0);});
 for(const path of ['/Private/a.png','/Downloads/Recall/a/../b.png',folder+'/a/b.png',folder+'/bad.recall.json'])await test('invalid destination '+path,{},async()=>{const p=payload();p.path=path;assert.equal((await api(p)).status,400);});
 await test('real database receipt-insert failure rolls back first media insert and ancillary rows',{},async()=>{
  const p=payload('trigger105');await pool.query('CREATE SEQUENCE tt105_trigger_hits');await pool.query(`CREATE FUNCTION tt105_fail_receipt() RETURNS trigger LANGUAGE plpgsql AS $$ BEGIN IF NEW.path LIKE '%/trigger105.png.recall.json' THEN PERFORM nextval('tt105_trigger_hits'); RAISE EXCEPTION 'tt105 real receipt constraint'; END IF; RETURN NEW; END $$`);await pool.query('CREATE TRIGGER tt105_fail BEFORE INSERT ON vfs_nodes FOR EACH ROW EXECUTE FUNCTION tt105_fail_receipt()');
  try{const r=await api(p);assert.equal(r.status,400);assert.match(r.data.error,/not acknowledged/);assert.ok(!JSON.stringify(r.data).includes(p.content));assert.ok(!r.data.error.includes('insert into'));assert.equal((await pool.query('SELECT is_called FROM tt105_trigger_hits')).rows[0].is_called,true);assert.equal((await rows(p.path)).length,0);assert.equal((await pool.query('SELECT 1 FROM index_docs WHERE ref=$1',[p.path])).rowCount,0);assert.equal((await pool.query('SELECT 1 FROM file_ops WHERE src=$1',[p.path])).rowCount,0);}finally{await pool.query('DROP TRIGGER tt105_fail ON vfs_nodes');await pool.query('DROP FUNCTION tt105_fail_receipt()');await pool.query('DROP SEQUENCE tt105_trigger_hits');}
 });
 await test('shared-writer refactor preserves standalone conditional create and replacement',{},async()=>{const path=folder+'/standalone.txt';assert.equal((await api({op:'writeIfUnchanged',path,content:'first',expected:null})).status,200);const [old]=(await pool.query('SELECT id,version,sha256 FROM vfs_nodes WHERE path=$1',[path])).rows;assert.equal((await api({op:'writeIfUnchanged',path,content:'second',expected:old})).status,200);assert.equal((await pool.query('SELECT content FROM vfs_nodes WHERE path=$1',[path])).rows[0].content,'second');assert.equal((await api({op:'writeIfUnchanged',path,content:'stale overwrite',expected:old})).status,409);assert.equal((await pool.query('SELECT content FROM vfs_nodes WHERE path=$1',[path])).rows[0].content,'second');});
 await test('patch-specific recovery: valid create after actual rollback succeeds',{},async()=>{const p=payload('trigger105');assert.equal((await api(p)).status,200);assert.equal((await rows(p.path)).length,2);});
}finally{await pool.end();}
finish();
