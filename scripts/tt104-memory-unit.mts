import assert from 'node:assert/strict';
import {createHash} from 'node:crypto';
import {oneResidentFile,verifyRecallReceipt} from '../src/lib/recall-memory.ts';
import {makeHarness} from './harness.mts';
const {test,finish}=makeHarness('tt104-memory-unit');
const bytes=new Uint8Array([0,1,2,255]),mime='image/png',path='/Downloads/Recall/unit/image.png';
const receipt={version:1,path,bytes:4,mime,sha256:createHash('sha256').update(bytes).digest('hex'),method:'human-paste-file',capturedAt:new Date().toISOString()};
await test('valid stored-byte receipt matches exact SHA-256',{'RC-19':'partial'},async()=>assert.equal((await verifyRecallReceipt(bytes,mime,path,JSON.stringify(receipt))).method,receipt.method));
for(const [key,value] of Object.entries({version:2,path:'/other',bytes:3,mime:'video/mp4',sha256:'0'.repeat(64),method:'',capturedAt:'not-a-date'}))await test('receipt mismatch rejected: '+key,{},async()=>assert.rejects(()=>verifyRecallReceipt(bytes,mime,path,JSON.stringify({...receipt,[key]:value}))));
for(const text of ['null','[]','42','{','x'.repeat(16385)])await test('invalid receipt admission '+text.slice(0,20),{},async()=>assert.rejects(()=>verifyRecallReceipt(bytes,mime,path,text)));
await test('tampered bytes fail despite same length',{},async()=>assert.rejects(()=>verifyRecallReceipt(new Uint8Array([0,1,3,255]),mime,path,JSON.stringify(receipt))));
await test('single native File admitted without rewriting its bytes',{'RC-16':'partial','RC-17':'partial'},async()=>{const f=new File([bytes],'one.png',{type:mime});assert.equal(oneResidentFile([f]),f);assert.deepEqual(new Uint8Array(await f.arrayBuffer()),bytes);});
for(const [name,files] of [ ['no files',[]],['multiple files',[new File([bytes],'a',{type:mime}),new File([bytes],'b',{type:mime})]],['empty file',[new File([],'a',{type:mime})]],['oversize',[new File([new Uint8Array(8388609)],'a',{type:mime})]],['HTML',[new File(['<img src="https://example.com">'],'a',{type:'text/html'})]],['playlist',[new File(['#EXTM3U'],'a',{type:'application/vnd.apple.mpegurl'})]],['unknown MIME',[new File([bytes],'a')]] ] as const)await test('resident admission rejects '+name,{},()=>assert.throws(()=>oneResidentFile(files)));
await test('exact 8 MiB boundary admitted',{},()=>assert.equal(oneResidentFile([new File([new Uint8Array(8388608)],'a',{type:mime})]).size,8388608));
await test('UTF-8 receipt cap rejects multibyte text below UTF-16 count limit',{},async()=>assert.rejects(()=>verifyRecallReceipt(bytes,mime,path,JSON.stringify({...receipt,padding:'🙂'.repeat(4200)}))));
await test('ambiguous numeric timestamp rejected',{},async()=>assert.rejects(()=>verifyRecallReceipt(bytes,mime,path,JSON.stringify({...receipt,capturedAt:'1'}))));
await test('normalized invalid calendar day rejected',{},async()=>assert.rejects(()=>verifyRecallReceipt(bytes,mime,path,JSON.stringify({...receipt,capturedAt:'2026-02-30T00:00:00.000Z'}))));
await test('empty stored bytes rejected even with a matching empty digest',{},async()=>assert.rejects(()=>verifyRecallReceipt(new Uint8Array(),mime,path,JSON.stringify({...receipt,bytes:0,sha256:createHash('sha256').update('').digest('hex')}))));
finish();
