import assert from 'node:assert/strict';
import pg from 'pg';
import {makeHarness} from './harness.mts';
import {metadataValues,metadataPage} from '../src/lib/search/metadata.ts';
import {readId3v2} from '../src/lib/meta/audio.ts';
import {delimitedMetadata} from '../src/lib/search/delimited.ts';
if(process.env.TT89_DISPOSABLE_DATABASE!=='1'||!process.env.BASE||!process.env.DATABASE_URL)throw new Error('Explicit disposable server, BASE and DATABASE_URL required');
const BASE=process.env.BASE,dir='/Documents/tt102-'+Date.now();
const boundary='tourmalineboundary'+Date.now();
const {test,finish}=makeHarness('tt102-search');
async function api(method:string,path:string,body?:unknown){const r=await fetch(BASE+path,{method,headers:{'content-type':'application/json'},body:body?JSON.stringify(body):undefined});const j=await r.json();assert.ok(r.ok,JSON.stringify(j));return j;}
const write=(name:string,content:string,mime='application/json',encoding='utf8')=>api('POST','/api/fs',{op:'write',path:dir+'/'+name,content,mime,encoding});
const query=(name:string,q:string,field='')=>api('GET','/api/search?'+new URLSearchParams({mode:'metadata',q,field,scope:dir+'/'+name}));
function sylt(entries:{text:string;time:number}[],format=2,enc=0){const encode=(s:string)=>enc===1?Buffer.concat([Buffer.from([255,254]),Buffer.from(s,'utf16le')]):Buffer.from(s,enc===3?'utf8':'latin1');return Buffer.concat([Buffer.from([enc]),Buffer.from('eng'),Buffer.from([format,1]),encode('draft'),Buffer.alloc(enc===1?2:1),...entries.flatMap(x=>{const time=Buffer.alloc(4);time.writeUInt32BE(x.time);return[encode(x.text),Buffer.alloc(enc===1?2:1),time];})]);}
function id3(data:Buffer){const h=Buffer.alloc(10);h.write('SYLT');h.writeUInt32BE(data.length,4);const body=Buffer.concat([h,data]);return Buffer.concat([Buffer.from([73,68,51,3,0,0,(body.length>>21)&127,(body.length>>14)&127,(body.length>>7)&127,body.length&127]),body]);}
await test('JSONL existing transcript values have structural provenance over real HTTP',{},async()=>{await write('lines.jsonl','{"transcript":"cerulean first"}\n{"lyrics":"ochre second"}','application/x-ndjson');assert.equal((await query('lines.jsonl','ochre','lyrics')).hits[0]?.matchedFields[0].field,'content.lines[1].lyrics');});
await test('JSONL malformed line does not hide later existing metadata; partial coverage is explicit',{},async()=>{await write('bad.jsonl','{bad}\n{"transcript":"azurite later"}');const r=await query('bad.jsonl','azurite','transcript');assert.equal(r.hits.length,1);assert.equal(r.truncatedFiles,1);assert.ok(r.warnings.length);});
await test('NDJSON MIME works without a recognized filename extension',{},async()=>{await write('typed.bin','{"transcript":"hematite typed"}','application/x-ndjson');assert.equal((await query('typed.bin','hematite','transcript')).hits.length,1);});
await test('vendor +json MIME works without a JSON suffix',{},async()=>{await write('vendor.bin','{"transcript":"cobalt vendor"}','application/vnd.example+json');assert.equal((await query('vendor.bin','cobalt','transcript')).hits.length,1);});
await test('CSV quoted newline, escaped quote and duplicate header values are searchable',{},async()=>{await write('values.csv','lyrics,lyrics\r\n"early, phrase","later ""quoted""\nmalachite"\r\n','text/csv');const r=await query('values.csv','malachite','lyrics');assert.equal(r.hits.length,1);assert.ok(r.hits[0].matchedFields[0].field.endsWith('lyrics[1]'));});
await test('TSV stored transcripts use tab boundaries, not commas',{},async()=>{await write('values.tsv','transcript\tartist\njasper spoken\tA,B','text/tab-separated-values');assert.equal((await query('values.tsv','jasper','transcript')).hits.length,1);});
await test('CSV hostile prototype-shaped header remains inert data',{},async()=>{await write('proto.csv','__proto__,constructor\nberyl data,ordinary','text/csv');assert.equal((await query('proto.csv','beryl','__proto__')).hits.length,1);assert.equal(({} as {polluted?:unknown}).polluted,undefined);});
await test('malformed CSV returns raw text and warning, not certified structured fields',{},async()=>{await write('bad.csv','transcript\n"unterminated goldstone','text/csv');const r=await query('bad.csv','goldstone');assert.equal(r.hits.length,1);assert.equal(r.truncatedFiles,1);assert.ok(r.warnings.length);assert.equal((await query('bad.csv','goldstone','transcript')).hits.length,0);});
await test('CSV cell budget is explicit and bounded in the original pure reader',{},()=>{const r=delimitedMetadata('lyrics\n'+Array.from({length:5000},()=> 'value').join('\n'),',');assert.ok(r.truncated);assert.ok(r.rows.length<4096);});
await test('JSON array field selection covers descendants without prefix matching siblings',{},async()=>{await write('array.json','{"lyrics":["moonstone"],"lyricsExtra":["moonstone"]}');const r=await query('array.json','moonstone','lyrics');assert.equal(r.hits[0].matchedFields.length,1);assert.ok(r.hits[0].matchedFields[0].field.endsWith('lyrics[0]'));});
const bytes=id3(sylt([{text:'rhodonite sung',time:1000},{text:'iolite words',time:2500}]));
await test('synchronized stored lyrics are found on an actual stored ID3 file',{},async()=>{await write('sync.mp3',bytes.toString('base64'),'audio/mpeg','base64');assert.equal((await query('sync.mp3','iolite','lyrics')).hits.length,1);});
await test('independent MIT parser agrees on SYLT text and millisecond timestamps',{},async()=>{const external=await import('/home/user/tools/node_modules/music-metadata/lib/index.js');const native=(await external.parseBuffer(bytes,{mimeType:'audio/mpeg'},{duration:false})).native['ID3v2.3'].find((x:{id:string})=>x.id==='SYLT').value;const ours=await readId3v2(bytes);assert.equal(native.syncText[1].text,'iolite words');assert.equal(native.syncText[1].timestamp,2500);assert.equal(ours?.tags['lyrics.synced.eng.draft'],native.syncText.map((x:{text:string})=>x.text).join('\n'));assert.equal(ours?.tags['lyrics.synced.eng.draft.timestamps'],'1000 ms; 2500 ms');});
await test('MPEG-frame timestamps are not falsely converted to milliseconds',{},async()=>{const r=await readId3v2(id3(sylt([{text:'frame words',time:42}],1)));assert.equal(r?.tags['lyrics.synced.eng.draft.timestamps'],'42 MPEG frames');assert.equal(r?.tags['lyrics.synced.eng.draft.timestampFormat'],'1');});
await test('UTF16 synchronized lyrics decode real Greek bytes',{},async()=>{const r=await readId3v2(id3(sylt([{text:'ατέρμων',time:0}],2,1)));assert.equal(r?.tags['lyrics.synced.eng.draft'],'ατέρμων');});
await test('SYLT timestamps retain unsigned 32-bit values without overflow',{},async()=>{const r=await readId3v2(id3(sylt([{text:'late words',time:3000000000}])));assert.equal(r?.tags['lyrics.synced.eng.draft.timestamps'],'3000000000 ms');});
await test('BOM-less ambiguous UTF16 synchronized segments are refused explicitly',{},async()=>{const data=sylt([{text:'ατέρμων',time:0}],2,1);const r=await readId3v2(id3(Buffer.concat([data.subarray(0,20),data.subarray(22)])));assert.ok(r?.warnings.some(x=>x.includes('ambiguous UTF-16')));assert.equal(r?.tags['lyrics.synced.eng.draft'],undefined);});
await test('unknown SYLT time format is refused rather than guessed',{},async()=>{const r=await readId3v2(id3(sylt([{text:'invalidtime',time:0}],3)));assert.ok(r?.warnings.some(x=>x.includes('invalid synchronized')));assert.equal(r?.tags['lyrics.synced.eng.draft'],undefined);});
await test('truncated SYLT timestamp cannot publish partial lyrics as complete',{},async()=>{const r=await readId3v2(id3(sylt([{text:'truncatedword',time:0}]).subarray(0,-1)));assert.ok(r?.warnings.length);assert.equal(r?.tags['lyrics.synced.eng.draft'],undefined);});
await test('descending SYLT times fail closed without sorting away the evidence',{},async()=>{const r=await readId3v2(id3(sylt([{text:'first',time:100},{text:'second',time:0}])));assert.ok(r?.warnings.length);assert.equal(r?.tags['lyrics.synced.eng.draft'],undefined);});
await test('SYLT entry budget refuses an over-limit frame explicitly',{},async()=>{const r=await readId3v2(id3(sylt(Array.from({length:4097},(_,i)=>({text:'x',time:i})))));assert.ok(r?.warnings.length);assert.equal(r?.tags['lyrics.synced.eng.draft'],undefined);});
await test('legacy fast search scope cannot include a sibling prefix',{},async()=>{await write('scope/a.txt',boundary,'text/plain');await write('scope-sibling/b.txt',boundary,'text/plain');const r=await api('GET','/api/search?'+new URLSearchParams({q:boundary,scope:dir+'/scope'}));assert.equal(r.hits.length,1);assert.ok(r.hits[0].ref.endsWith('/scope/a.txt'));});
await test('legacy scope accepts trailing separators without reopening sibling-prefix leakage',{},async()=>{for(const suffix of ['/','////']){const r=await api('GET','/api/search?'+new URLSearchParams({q:boundary,scope:dir+'/scope'+suffix}));assert.equal(r.hits.length,1);assert.ok(r.hits[0].ref.endsWith('/scope/a.txt'));}});
await test('legacy root search isolates its unique sentinel from prior-run common-word noise',{},async()=>{await write('old-noise.txt','tourmalineboundary','text/plain');const r=await api('GET','/api/search?'+new URLSearchParams({q:boundary,scope:'/'}));assert.equal(r.hits.length,2);});
await test('unimplemented rebuild reports 501 and rebuilt false, not a fabricated success',{},async()=>{const r=await fetch(BASE+'/api/search',{method:'POST'});assert.equal(r.status,501);assert.equal((await r.json()).rebuilt,false);});
await test('metadata wildcard-shaped folder scope remains literal SQL data',{},async()=>{await write('literal%_/a.json','{"transcript":"wildcardsentinel"}');await write('literalZZ/b.json','{"transcript":"wildcardsentinel"}');const r=await query('literal%_','wildcardsentinel','transcript');assert.equal(r.hits.length,1);assert.ok(r.hits[0].ref.includes('literal%_'));});
await test('SQL projection preserves every existing non-content node column',{},async()=>{await write('columns.json','{"lyrics":"projection witness"}');await api('POST','/api/fs',{op:'tag',path:dir+'/columns.json',tags:'labradorite projectiontag'});const db=new pg.Client({connectionString:process.env.DATABASE_URL});await db.connect();try{const row=(await db.query("select to_jsonb(n)-'content' as record from vfs_nodes n where path=$1",[dir+'/columns.json'])).rows[0].record;for(const[k,v]of Object.entries(row)){if(v==='')continue;const q=String(v);const r=await query('columns.json',q,'node.'+k);assert.equal(r.hits.length,1,k);}}finally{await db.end();}});
await test('over-budget content still exposes stored node SHA and explicit skip warning',{},async()=>{await write('large.txt','x'.repeat(270000),'text/plain');const n=(await api('GET','/api/fs?'+new URLSearchParams({op:'stat',path:dir+'/large.txt'}))).node;const r=await query('large.txt',n.sha256,'sha256');assert.equal(r.hits.length,1);assert.equal(r.truncatedFiles,1);});
await test('AND terms cannot be satisfied across different files',{},async()=>{await write('and/a.json','{"a":"spinel"}');await write('and/b.json','{"b":"zircon"}');assert.equal((await query('and','spinel zircon')).hits.length,0);await write('and/c.json','{"a":"spinel","b":"zircon"}');assert.equal((await query('and','spinel zircon')).hits.length,1);});
await test('absent transcript is not generated from arbitrary binary bytes',{},async()=>{await write('absent.bin',Buffer.from([0,1,2,3]).toString('base64'),'application/octet-stream','base64');const r=await query('absent.bin','fabricatedspeech','transcript');assert.equal(r.hits.length,0);assert.ok(r.warnings.length);});
await test('CSV exact quoting and empty trailing cell pure witness',{},()=>{const r=delimitedMetadata('a,b\n"one ""quote""",\n',',');assert.deepEqual(r.rows[0].a,['one "quote"']);assert.deepEqual(r.rows[0].b,['']);assert.equal(r.truncated,false);});
await test('malformed quote suffix is refused by the pure CSV reader',{},()=>assert.throws(()=>delimitedMetadata('a\n"x"injected',',')));
await test('query page cap remains 32 under the new readers',{},async()=>{const r=await metadataPage(Array.from({length:40},(_,i)=>({path:'/x/'+i,name:'x.jsonl',mime:'application/x-ndjson',encoding:'utf8',content:'{"transcript":"pagecap"}'})),{q:'pagecap',field:'transcript',cursor:''});assert.equal(r.hits.length,32);});
await test('JSONL field budget reports truncation rather than scanning unlimited records',{},async()=>{const r=await metadataValues({path:'/x',name:'x.jsonl',mime:'application/x-ndjson',encoding:'utf8',content:Array.from({length:4500},()=>'{"lyrics":"a"}').join('\n')});assert.equal(r.truncated,true);assert.ok(r.fields.length<=4096);});
finish();
