import assert from 'node:assert/strict';
import {createHash} from 'node:crypto';
import {readFileSync} from 'node:fs';
import pg from 'pg';
import {makeHarness} from './harness.mts';
import {launchChromium} from './browser-launch.mts';
if(process.env.TT89_DISPOSABLE_DATABASE!=='1'||!process.env.BASE||!process.env.DATABASE_URL)throw new Error('Exclusive disposable server required');
const BASE=process.env.BASE,UP='http://127.0.0.1:4001',tag='tt102-ui-'+Date.now();
const {test,finish}=makeHarness('e2e-tt102');
async function api(method:string,path:string,body?:unknown){const r=await fetch(BASE+path,{method,headers:{'content-type':'application/json'},body:body?JSON.stringify(body):undefined});const j=await r.json();assert.ok(r.ok,JSON.stringify(j));return j;}
async function poll(f:()=>Promise<boolean>,label:string,ms=25000){const end=Date.now()+ms;do{if(await f())return;await new Promise(r=>setTimeout(r,100));}while(Date.now()<end);throw new Error('Timeout '+label);}
async function desktop(windows:unknown[]){const old=await api('GET','/api/state?id=default');await api('PUT','/api/state',{id:'default',revision:Number(old.row?.revision??1)+1000,state:{...old.row?.state,windows,focus:(windows.at(-1) as {id:string})?.id,nextZ:20,activeWorkspace:1,workspaces:[{id:1,name:'Main'}]}});}
const win=(id:string,module:string,x:number,w:number,props={})=>({id,module,title:module==='recall'?'Recall':module==='privacy'?'Privacy':'Find',props,x,y:45,w,h:810,z:module==='find'?15:11,workspace:1,minimized:false,maximized:false,host:'tab'});
const browser=await launchChromium();const page=await browser.newPage({viewport:{width:1440,height:1000}}),errors:string[]=[];page.on('pageerror',e=>errors.push(e.message));
const listing=async()=>((await api('GET','/api/fs?'+new URLSearchParams({op:'list',path:'/Downloads/Recall/'+tag}))).nodes??[]) as {path:string;name:string}[];
try{
 await api('GET','/api/settings'); // Bootstrap before PUT on a genuinely fresh database.
 await api('PUT','/api/settings',{key:'appearance.desktopView',value:'classic'});
 await desktop([win('r102','recall',20,1360,{url:UP+'/',proxyAll:true})]);await page.goto(BASE);const recall=page.getByTestId('recall');
 await test('Recall opens a real browsing pane without silently arming capture',{},async()=>{await recall.getByRole('button',{name:'Browse inside Recall',exact:true}).click();const pane=recall.getByRole('region',{name:'Recall browser',exact:true});await pane.frameLocator('[data-testid=wp-frame]').getByRole('heading',{name:'Recall fixture',exact:true}).waitFor();await poll(async()=>await pane.frameLocator('[data-testid=wp-frame]').locator('img').first().evaluate((img:HTMLImageElement)=>img.complete&&img.naturalWidth>0&&img.naturalHeight>0),'native publisher image decode');assert.equal(await pane.getByTestId('recall-auto').textContent(),'Enable Auto Recall');assert.equal(await pane.getByRole('button',{name:'Recall media',exact:true}).count(),0);assert.equal(await pane.getByRole('button',{name:'Recall jobs',exact:true}).count(),0);});
 await test('compact Browser tools retain advanced controls without crowding the default bar',{},async()=>{const pane=recall.getByRole('region',{name:'Recall browser',exact:true});assert.equal(await pane.getByRole('button',{name:'Close duplicates',exact:true}).isVisible(),false);await pane.getByRole('button',{name:'Browser tools',exact:true}).click();assert.equal(await pane.getByRole('button',{name:'Close duplicates',exact:true}).isVisible(),true);await pane.getByRole('button',{name:'Browser tools',exact:true}).click();});
 await test('Page tools retain functional find while the default viewport stays usable',{},async()=>{const pane=recall.getByRole('region',{name:'Recall browser',exact:true});assert.equal(await pane.getByLabel('Find in page',{exact:true}).isVisible(),false);await pane.getByRole('button',{name:'Page tools',exact:true}).click();await pane.getByLabel('Find in page',{exact:true}).fill('Recall');await pane.getByLabel('Find in page',{exact:true}).press('Enter');await poll(async()=>/\d+\/\d+/.test(await pane.getByTestId('wp-find-count').textContent()??''),'actual page find');await pane.getByRole('button',{name:'Page tools',exact:true}).click();const box=await pane.getByTestId('wp-frame').boundingBox();assert.ok(box&&box.height>=250,JSON.stringify(box));});
 await test('actual page title and address follow the visible proxied document',{},async()=>{await poll(async()=>await recall.getByLabel('Recall page title',{exact:true}).inputValue()==='Recall live publisher','title follows');assert.equal(await recall.getByLabel('Recall source URL',{exact:true}).inputValue(),UP+'/');});
 await test('manual browsing changes the visible page and declared source together',{},async()=>{const pane=recall.getByRole('region',{name:'Recall browser',exact:true});await pane.getByLabel('Address',{exact:true}).fill(UP+'/?secondpage=1');await pane.getByRole('button',{name:'Go',exact:true}).click();await poll(async()=>await recall.getByLabel('Recall source URL',{exact:true}).inputValue()===UP+'/?secondpage=1','active page follows');await pane.frameLocator('[data-testid=wp-frame]').getByRole('heading',{name:'Recall fixture',exact:true}).waitFor();});
 await test('Auto Recall in the new browser saves actual publisher bytes to the selected folder',{},async()=>{const pane=recall.getByRole('region',{name:'Recall browser',exact:true});await pane.getByLabel('Auto Recall folders',{exact:true}).selectOption('custom');await pane.getByLabel('Auto Recall custom folder',{exact:true}).fill(tag);await pane.getByTestId('recall-auto').click();await poll(async()=> (await listing()).some(n=>n.name.endsWith('.png')),'archive actual image');const image=(await listing()).find(n=>n.name.endsWith('.png'))!;const saved=await api('GET','/api/fs?'+new URLSearchParams({op:'read',path:image.path}));const upstream=Buffer.from(await(await fetch(UP+'/image.png')).arrayBuffer());assert.equal(createHash('sha256').update(Buffer.from(saved.node.content,'base64')).digest('hex'),createHash('sha256').update(upstream).digest('hex'));});
 await test('real publisher DOM mutation is discovered from the visible page',{},async()=>{const pane=recall.getByRole('region',{name:'Recall browser',exact:true});await pane.frameLocator('[data-testid=wp-frame]').getByRole('button',{name:'Add real media',exact:true}).click();await poll(async()=> (await listing()).filter(n=>n.name.endsWith('.png')).length===2,'second exposed image');});
 await test('closing the browsing pane cancels its actual slow archive fetch',{},async()=>{const pane=recall.getByRole('region',{name:'Recall browser',exact:true});await pane.frameLocator('[data-testid=wp-frame]').getByRole('button',{name:'Add slow media',exact:true}).click();await recall.locator('li[data-phase=fetching]').filter({hasText:'/slow'}).waitFor();await recall.getByRole('button',{name:'Close browsing pane',exact:true}).click();await recall.locator('li[data-phase=cancelled]').filter({hasText:'/slow'}).waitFor();assert.equal(await recall.getByRole('region',{name:'Recall browser',exact:true}).count(),0);});
 await test('reopening restores the actual active tab but does not restore an armed watcher',{},async()=>{await recall.getByRole('button',{name:'Browse inside Recall',exact:true}).click();const pane=recall.getByRole('region',{name:'Recall browser',exact:true});await pane.frameLocator('[data-testid=wp-frame]').getByRole('heading',{name:'Recall fixture',exact:true}).waitFor();assert.equal(await pane.getByLabel('Address',{exact:true}).inputValue(),UP+'/?secondpage=1');assert.equal(await pane.getByTestId('recall-auto').textContent(),'Enable Auto Recall');await page.screenshot({path:'docs/evidence/tt102-recall-browser.png'});});
 await test('new browser pane passes serious and critical external axe checks',{},async()=>{await page.addScriptTag({content:readFileSync('node_modules/axe-core/axe.min.js','utf8')});const violations=await page.evaluate(async()=>{const axe=(window as unknown as {axe:{run:(node:Element)=>Promise<{violations:{id:string;impact:string}[]}>}}).axe;return(await axe.run(document.querySelector('[data-testid=recall]')!)).violations.filter(v=>v.impact==='serious'||v.impact==='critical');});assert.deepEqual(violations,[]);});
 // A real UI-created encrypted volume, never supplied fabricated key material to browser internals.
 await desktop([win('p102','privacy',10,600),win('f102','find',625,795)]);await page.goto(BASE);const priv=page.getByTestId('privacy'),find=page.locator('.fs-window[aria-label=Find]');
 const secret='sideriteprivate-'+tag,privateDir='/Private/'+tag;
 await test('create or unlock real Persistent Storage through its actual UI',{},async()=>{const create=priv.getByTestId('create');await poll(async()=>await create.count()>0||await priv.getByTestId('unlock').count()>0,'privacy ready');const pass='TT102 basalt river honest browser volume';if(await create.count()){await priv.getByTestId('pp1').fill(pass);await priv.getByTestId('pp2').fill(pass);await create.click();await priv.getByTestId('recovery-key').waitFor({timeout:60000});}else{await priv.getByTestId('unlock-pass').fill(pass);await priv.getByTestId('unlock').click();}await priv.getByTestId('lock').waitFor({timeout:60000});});
 const requests:string[]=[];const observer=(r:import('playwright').Request)=>requests.push(r.url()+' '+(r.postData()??''));page.on('request',observer);
 await test('unlocked actual-browser metadata search decrypts real writes without HTTP plaintext',{},async()=>{const r=await page.evaluate(async({path,secret})=>{const response=await fetch('/api/fs',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({op:'write',path,content:JSON.stringify({transcript:secret}),mime:'application/json'})});return{status:response.status,body:await response.json()};},{path:privateDir+'/words.json',secret});assert.equal(r.status,200,JSON.stringify(r.body));await find.getByLabel('Search mode',{exact:true}).selectOption('metadata');await find.getByLabel('Scope',{exact:true}).fill(privateDir);await find.getByLabel('Metadata field',{exact:true}).fill('transcript');await find.getByLabel('Search query',{exact:true}).fill(secret);await find.getByRole('button',{name:'Search',exact:true}).click();await find.getByLabel('Matched metadata fields').filter({hasText:secret}).waitFor();assert.ok(!requests.some(x=>x.includes(secret)));const db=new pg.Client({connectionString:process.env.DATABASE_URL});await db.connect();try{assert.equal((await db.query('select count(*)::int n from vfs_nodes where content like $1 or path like $1',['%'+secret+'%'])).rows[0].n,0);}finally{await db.end();}});
 await test('actual storage lock clears rendered result, query, field, cursor and scope',{},async()=>{await priv.getByPlaceholder('Current passphrase',{exact:true}).fill('not retained after lock');await priv.getByPlaceholder('New passphrase',{exact:true}).fill('not retained new password');await priv.getByTestId('backup-pass').fill('not retained backup password');await priv.getByTestId('lock').click();await poll(async()=>await find.getByLabel('Search query',{exact:true}).inputValue()==='','lock clearing');assert.equal(await find.getByLabel('Matched metadata fields').count(),0);assert.equal(await find.getByLabel('Metadata field',{exact:true}).inputValue(),'');assert.equal(await find.getByLabel('Scope',{exact:true}).inputValue(),'');assert.equal(await find.getByRole('button',{name:'Search next metadata page',exact:true}).count(),0);assert.ok(!(await find.textContent())?.includes(secret));assert.equal(await priv.getByTestId('recovery-key').count(),0);assert.equal(await priv.getByTestId('unlock-pass').inputValue(),'');await page.screenshot({path:'docs/evidence/tt102-private-locked.png'});});
 await test('post-lock retry fails closed and cannot resurrect old plaintext results',{},async()=>{requests.length=0;await find.getByLabel('Scope',{exact:true}).fill(privateDir);await find.getByLabel('Search query',{exact:true}).fill(secret);await find.getByRole('button',{name:'Search',exact:true}).click();await find.getByRole('alert').filter({hasText:'locked'}).waitFor();assert.equal(await find.getByLabel('Matched metadata fields').count(),0);assert.ok(!requests.some(x=>x.includes(secret)));await priv.getByTestId('unlock-pass').fill('TT102 basalt river honest browser volume');await priv.getByTestId('unlock').click();await priv.getByTestId('lock').waitFor({timeout:60000});assert.equal(await priv.getByPlaceholder('New passphrase',{exact:true}).inputValue(),'');assert.equal(await priv.getByTestId('backup-pass').inputValue(),'');assert.equal(await priv.getByTestId('recovery-key').count(),0);await priv.getByTestId('lock').click();});
 page.off('request',observer);
 await test('classic desktop keeps a named semantic group and passes external prohibited-ARIA checks',{},async()=>{const group=page.getByRole('group',{name:'Desktop',exact:true});await group.waitFor();await page.addScriptTag({content:readFileSync('node_modules/axe-core/axe.min.js','utf8')});const issues=await page.evaluate(async()=>{const axe=(window as unknown as {axe:{run:(n:Element,options:unknown)=>Promise<{violations:{id:string}[]}>}}).axe;return(await axe.run(document.querySelector('[data-pointer-gesture-surface=classic]')!,{runOnly:{type:'rule',values:['aria-prohibited-attr']}})).violations;});assert.deepEqual(issues,[]);});
 await test('actual TT102 browser interactions have no uncaught page errors',{},()=>assert.deepEqual(errors,[]));
}finally{await browser.close();}
finish();
