/** Actual clean-preview smoke; writes one clearly authored example, never a purported audio transcript. */
import assert from 'node:assert/strict';
import {launchChromium} from './browser-launch.mts';
if(process.env.TT101_PREVIEW_EXAMPLE!=='1'||!process.env.BASE)throw new Error('Explicit preview-example opt-in and BASE required');
const BASE=process.env.BASE,path='/Documents/metadata-search-example.json';
const content=JSON.stringify({title:'An explicitly authored metadata-search example',transcript:'Example transcript text already stored in a JSON file. This text was not extracted or generated from audio.',lyrics:'Example lyric words already stored in this JSON file. No audio transcription or lyric retrieval was performed.'},null,2);
const existing=await fetch(BASE+'/api/fs?'+new URLSearchParams({op:'stat',path}));
const previous=existing.ok?await existing.json():null;
if(previous?.node){const read=await fetch(BASE+'/api/fs?'+new URLSearchParams({op:'read',path}));const j=await read.json();assert.equal(j.node?.content,content,'Refusing to overwrite a user-edited example');}
else{const written=await fetch(BASE+'/api/fs',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({op:'write',path,content,mime:'application/json'})});assert.ok(written.ok,await written.clone().text());}
const queried=await fetch(BASE+'/api/search?'+new URLSearchParams({mode:'metadata',scope:path,field:'transcript',q:'already stored'}));const result=await queried.json();assert.ok(queried.ok);assert.equal(result.hits[0]?.ref,path);assert.equal(result.scanned,1);
const browser=await launchChromium();
try{const page=await browser.newPage({viewport:{width:1440,height:1000}});const errors:string[]=[];page.on('pageerror',e=>errors.push(e.message));await page.goto(BASE+'/?open=find');const wins=page.locator('.fs-window[aria-label=Find]');await wins.last().getByLabel('Search mode',{exact:true}).waitFor();while(await wins.count()>1)await wins.first().getByRole('button',{name:'Close window',exact:true}).click();const win=wins.last();await win.getByLabel('Search mode',{exact:true}).selectOption('metadata');await win.getByLabel('Scope',{exact:true}).fill(path);await win.getByLabel('Metadata field',{exact:true}).fill('transcript');await win.getByLabel('Search query',{exact:true}).fill('already stored');await win.getByRole('button',{name:'Search',exact:true}).click();await win.getByLabel('Matched metadata fields').waitFor();await win.getByRole('button',{name:'Maximise or restore',exact:true}).click();await page.screenshot({path:'docs/evidence/tt101-preview.png'});assert.deepEqual(errors,[]);console.log('PASS: real clean-preview HTTP metadata query and Chromium UI, one explicit authored example, zero page errors');}finally{await browser.close();}
