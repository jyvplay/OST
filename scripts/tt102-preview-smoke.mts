/** Explicit preview-only authored examples and an actual external public-repository browsing experiment. */
import assert from 'node:assert/strict';
import {launchChromium} from './browser-launch.mts';
if(process.env.TT102_PREVIEW_EXAMPLE!=='1'||!process.env.BASE)throw new Error('Explicit preview opt-in and BASE required');
const BASE=process.env.BASE,path='/Documents/metadata-search-example.csv',content='transcript,lyrics\n"Bluewater example text already stored in this CSV; not extracted from audio.","Authored lyric example, not generated from music."\n';
async function api(method:string,url:string,body?:unknown){const r=await fetch(BASE+url,{method,headers:{'content-type':'application/json'},body:body?JSON.stringify(body):undefined});const j=await r.json();assert.ok(r.ok,JSON.stringify(j));return j;}
const stat=await fetch(BASE+'/api/fs?'+new URLSearchParams({op:'stat',path}));const previous=stat.ok?await stat.json():null;
if(previous?.node){const read=await api('GET','/api/fs?'+new URLSearchParams({op:'read',path}));assert.equal(read.node.content,content,'Refusing to overwrite a user-edited example');}else await api('POST','/api/fs',{op:'write',path,content,mime:'text/csv'});
const r=await api('GET','/api/search?'+new URLSearchParams({mode:'metadata',scope:path,q:'Bluewater',field:'transcript'}));assert.equal(r.hits[0]?.ref,path);assert.equal(r.scanned,1);
const old=await api('GET','/api/state?id=default');await api('PUT','/api/state',{id:'default',revision:Number(old.row?.revision??1)+1000,state:{...old.row?.state,windows:[{id:'tt102-preview-recall',module:'recall',title:'Recall',props:{url:'https://github.com/jyvplay/OST',proxyAll:true},x:15,y:45,w:1380,h:830,z:15,minimized:false,maximized:false,workspace:1,host:'tab'}],focus:'tt102-preview-recall',nextZ:20,activeWorkspace:1,workspaces:[{id:1,name:'Main'}]}});
const browser=await launchChromium();try{const page=await browser.newPage({viewport:{width:1440,height:1000}});await page.goto(BASE);const recall=page.getByTestId('recall');await recall.getByRole('button',{name:'Browse inside Recall',exact:true}).click();const frame=recall.getByRole('region',{name:'Recall browser',exact:true}).frameLocator('[data-testid=wp-frame]');await frame.locator('body').filter({hasText:'OST'}).waitFor({timeout:60000});const body=await frame.locator('body').innerText();assert.ok(!body.includes('Could not reach github.com'),'Proxy error page is not repository content');await frame.getByRole('link',{name:/package\.json/}).first().waitFor({timeout:15000});assert.ok(body.includes('package.json'),'Repository file listing must exist, not merely its URL');await frame.getByRole('link',{name:/package\.json/}).first().scrollIntoViewIfNeeded();await page.screenshot({path:'docs/evidence/tt102-preview.png'});console.log('PASS: actual public GitHub repository HTML rendered through the normal preview proxy; no media archival was armed. External script/asset fidelity is not certified.');await page.goto(BASE+'/?open=find');const find=page.locator('.fs-window[aria-label=Find]').last();await find.getByLabel('Search mode',{exact:true}).selectOption('metadata');await find.getByLabel('Scope',{exact:true}).fill(path);await find.getByLabel('Metadata field',{exact:true}).fill('transcript');await find.getByLabel('Search query',{exact:true}).fill('Bluewater');await find.getByRole('button',{name:'Search',exact:true}).click();await find.getByLabel('Matched metadata fields').waitFor();await find.getByRole('button',{name:'Maximise or restore',exact:true}).click();await page.screenshot({path:'docs/evidence/tt102-preview-search.png'});await find.getByRole('button',{name:'Close window',exact:true}).click();console.log('PASS: normal preview HTTP/Chromium CSV field search; one explicitly authored example, not ASR or lyric generation.');}finally{await browser.close();}
