import assert from 'node:assert/strict';
import {createHash} from 'node:crypto';
import {launchChromium} from './browser-launch.mts';
import {makeHarness} from './harness.mts';
const BASE=process.env.BASE;if(!BASE||process.env.TT89_DISPOSABLE_DATABASE!=='1')throw Error('Exclusive disposable target required');
const {test,finish}=makeHarness('e2e-tt103-memory');
async function api(method:string,path:string,body?:unknown){const r=await fetch(BASE+path,{method,headers:{'content-type':'application/json'},body:body?JSON.stringify(body):undefined});const j=await r.json();assert.ok(r.ok,JSON.stringify(j));return j;}
const b=await launchChromium(),page=await b.newPage({viewport:{width:1440,height:1000}});const tag='tt103-'+Date.now();
try{
 await api('GET','/api/settings');const state=await api('GET','/api/state?id=default');await api('PUT','/api/state',{id:'default',revision:(state.row?.revision??1)+1000,state:{...state.row?.state,windows:[{id:'memory103',module:'recall',title:'Recall',props:{url:'http://127.0.0.1:4002/',proxyAll:true},x:15,y:45,w:1380,h:850,z:20,workspace:1}],focus:'memory103',nextZ:21,activeWorkspace:1}});await page.goto(BASE!);
 const recall=page.getByTestId('recall');await recall.getByLabel('Recall folder grouping',{exact:true}).selectOption('custom');await recall.getByLabel('Recall custom folder',{exact:true}).fill(tag);
 const path='/Downloads/Recall/'+tag;const nodes=async()=>((await api('GET','/api/fs?'+new URLSearchParams({op:'list',path}))).nodes??[]) as {path:string;mime:string;name:string}[];
 const png=Buffer.from(await page.evaluate(async()=>{const c=document.createElement('canvas');c.width=8;c.height=8;const x=c.getContext('2d')!;x.fillStyle='red';x.fillRect(0,0,8,8);const blob=await new Promise<Blob>(r=>c.toBlob(b=>r(b!)));return Array.from(new Uint8Array(await blob.arrayBuffer()));}));
 await test('human-selected actual PNG bytes save unchanged with honest method receipt',{'RC-01':'partial','RC-09':'partial'},async()=>{await recall.getByLabel('Choose resident media').setInputFiles({name:'already-loaded.png',mimeType:'image/png',buffer:png});await recall.getByRole('status').filter({hasText:'Saved memory →'}).waitFor();const n=(await nodes()).find(n=>n.mime==='image/png')!;const r=await api('GET','/api/fs?'+new URLSearchParams({op:'read',path:n.path}));assert.deepEqual(Buffer.from(r.node.content,'base64'),png);const receipt=await api('GET','/api/fs?'+new URLSearchParams({op:'read',path:n.path+'.recall.json'}));const j=JSON.parse(receipt.node.content);assert.equal(j.method,'human-selected-file');assert.equal(j.sha256,createHash('sha256').update(png).digest('hex'));});
 await test('timeline actually lists saved file and replay decodes in native image element',{'RC-07':'partial','RC-08':'partial'},async()=>{await recall.getByRole('button',{name:'Refresh memory timeline',exact:true}).click();const entry=recall.getByRole('list',{name:'Memory timeline'}).getByRole('button').first();await entry.click();const image=recall.getByRole('img',{name:'Saved memory',exact:true});await image.waitFor();await image.evaluate(async(img:HTMLImageElement)=>{await img.decode();});assert.equal(await image.evaluate((img:HTMLImageElement)=>img.naturalWidth),8);});
 await test('closing memory preview removes media and revokes visible reference',{},async()=>{await recall.getByRole('button',{name:'Close memory preview'}).click();assert.equal(await recall.getByRole('img',{name:'Saved memory',exact:true}).count(),0);});
 await test('zero-sized file is refused without a new archive',{},async()=>{const before=(await nodes()).length;await recall.getByLabel('Choose resident media').setInputFiles({name:'empty.png',mimeType:'image/png',buffer:Buffer.alloc(0)});await recall.getByRole('status').filter({hasText:'nonempty'}).waitFor();assert.equal((await nodes()).length,before);});
 await test('oversized file is refused before archive',{},async()=>{const before=(await nodes()).length;await recall.getByLabel('Choose resident media').setInputFiles({name:'too-large.png',mimeType:'image/png',buffer:Buffer.alloc(8388609)});await recall.getByRole('status').filter({hasText:'8 MiB'}).waitFor();assert.equal((await nodes()).length,before);});
 await test('nonmedia MIME is refused without archive',{},async()=>{const before=(await nodes()).length;await recall.getByLabel('Choose resident media').setInputFiles({name:'script.html',mimeType:'text/html',buffer:Buffer.from('<script>1</script>')});await recall.getByRole('status').filter({hasText:'Not a complete'}).waitFor();assert.equal((await nodes()).length,before);});
 await recall.getByRole('button',{name:'Browse inside Recall',exact:true}).click();const pane=recall.getByRole('region',{name:'Recall browser',exact:true});const frame=pane.frameLocator('[data-testid=wp-frame]');await frame.getByRole('heading',{name:'Already viewed visual'}).waitFor();await pane.getByLabel('Auto Recall folders',{exact:true}).selectOption('custom');await pane.getByLabel('Auto Recall custom folder',{exact:true}).fill(tag);
 await test('saving loaded visual uses already rendered pixels and no asset request',{'RC-03':'partial','RC-11':'partial'},async()=>{const before=await(await fetch('http://127.0.0.1:4002/count')).json();await pane.getByRole('button',{name:'Save largest loaded visual'}).click();await pane.getByText('Saved loaded visual →',{exact:false}).waitFor();const after=await(await fetch('http://127.0.0.1:4002/count')).json();assert.equal(after.assetRequests,before.assetRequests);assert.equal((await nodes()).filter(n=>n.mime==='image/png').length,2);});
 await test('subsequent human save captures changed viewed pixels as distinct memory',{},async()=>{await frame.getByRole('button',{name:'Change viewed pixels'}).click();assert.equal(await frame.locator('canvas').evaluate((c:HTMLCanvasElement)=>Array.from(c.getContext('2d')!.getImageData(0,0,1,1).data).join(',')),'0,255,0,255');await pane.getByRole('button',{name:'Save largest loaded visual'}).click();for(let i=0;i<100&&(await nodes()).filter(n=>n.mime==='image/png').length<3;i++)await page.waitForTimeout(100);assert.equal((await nodes()).filter(n=>n.mime==='image/png').length,3);await recall.getByRole('button',{name:'Refresh memory timeline',exact:true}).click();await recall.getByRole('list',{name:'Memory timeline'}).getByRole('button').first().waitFor();for(let i=0;i<100&&await recall.getByRole('list',{name:'Memory timeline'}).getByRole('button').count()<3;i++)await page.waitForTimeout(100);await recall.getByRole('list',{name:'Memory timeline'}).getByRole('button').first().click();const image=recall.getByRole('img',{name:'Saved memory',exact:true});await image.waitFor();await image.evaluate(async(img:HTMLImageElement)=>{await img.decode();});assert.equal(await image.evaluate((img:HTMLImageElement)=>{const c=document.createElement('canvas');c.width=1;c.height=1;const x=c.getContext('2d')!;x.drawImage(img,0,0);return Array.from(x.getImageData(0,0,1,1).data).join(',');}),'0,255,0,255');await image.scrollIntoViewIfNeeded();await page.screenshot({path:'docs/evidence/tt103-replay.png'});});
 await test('unsolicited parent-window result cannot create archive',{},async()=>{const before=(await nodes()).length;await page.evaluate(()=>window.postMessage({fusionWp:'recall-loaded-result',token:'forged',blob:new Blob(['bad'],{type:'image/png'})},'*'));await page.waitForTimeout(300);assert.equal((await nodes()).length,before);});
 if(process.env.TT103_ATTACK==='1')await test('real producer with valid request token cannot smuggle a header-only PNG past native decoder',{},async()=>{
  await frame.locator('canvas').evaluate(()=>{window.addEventListener('message',e=>{if(e.data?.fusionWp!=='recall-loaded')return;e.stopImmediatePropagation();const bytes=new Uint8Array(33);bytes.set([137,80,78,71,13,10,26,10]);const view=new DataView(bytes.buffer);view.setUint32(8,13);bytes.set([73,72,68,82],12);view.setUint32(16,8);view.setUint32(20,8);parent.postMessage({fusionWp:'recall-loaded-result',token:e.data.token,blob:new Blob([bytes],{type:'image/png'})},'*');},{capture:true,once:true});});
  const before=(await nodes()).length;await pane.getByRole('button',{name:'Save largest loaded visual'}).click();await pane.getByText('Not saved:',{exact:false}).waitFor();assert.equal((await nodes()).length,before);
 });
 await test('origin-tainted already-loaded surface fails without refetch fallback',{},async()=>{await frame.getByRole('button',{name:'Load opaque image'}).click();for(let i=0;i<100;i++){const tainted=await frame.locator('canvas').evaluate((c:HTMLCanvasElement)=>{try{c.getContext('2d')!.getImageData(0,0,1,1);return false;}catch{return true;}});if(tainted)break;await page.waitForTimeout(100);}assert.equal(await frame.locator('canvas').evaluate((c:HTMLCanvasElement)=>{try{c.toDataURL();return false;}catch{return true;}}),true);const before=(await nodes()).length;const counts=await(await fetch('http://127.0.0.1:4002/count')).json();await pane.getByRole('button',{name:'Save largest loaded visual'}).click();await pane.getByText('Not saved:',{exact:false}).waitFor();assert.equal((await nodes()).length,before);assert.deepEqual(await(await fetch('http://127.0.0.1:4002/count')).json(),counts);});
 await test('Specs contains all fifteen truthful Recall requirements, no A-grade fabrication',{},async()=>{const r=await api('GET','/api/features');const rows=(r.rows??r.features) as {code:string;status:string}[];const own=rows.filter(r=>/^RC-\d\d$/.test(r.code));assert.equal(own.length,15);assert.ok(own.every(r=>r.status==='partial'));});
 await page.screenshot({path:'docs/evidence/tt103-memory.png'});
}finally{await b.close();}
finish();
