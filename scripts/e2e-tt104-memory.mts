import assert from 'node:assert/strict';
import {readFileSync,writeFileSync} from 'node:fs';
import {launchChromium} from './browser-launch.mts';
import {makeHarness} from './harness.mts';
const BASE=process.env.BASE;if(!BASE||process.env.TT89_DISPOSABLE_DATABASE!=='1')throw Error('Disposable target required');
const {test,finish}=makeHarness('e2e-tt104-memory');
const api=async(method:string,path:string,body?:unknown)=>{const r=await fetch(BASE+path,{method,headers:{'content-type':'application/json'},body:body?JSON.stringify(body):undefined});const data=await r.json();assert.ok(r.ok,JSON.stringify(data));return data;};
const browser=await launchChromium(),page=await browser.newPage({viewport:{width:1440,height:1100},acceptDownloads:true});page.setDefaultTimeout(15000);
try{
 await api('GET','/api/settings');const original=await api('GET','/api/state?id=default');
 await api('PUT','/api/state',{id:'default',revision:(original.row?.revision??0)+100,state:{...original.row?.state,windows:[{id:'rec104',module:'recall',title:'Recall',props:{url:'http://127.0.0.1:4002/',proxyAll:true},x:15,y:45,w:1380,h:970,z:20,workspace:1}],focus:'rec104',activeWorkspace:1,nextZ:21}});
 await page.goto(BASE);const recall=page.getByTestId('recall'),tag='ui104-'+Date.now(),path='/Downloads/Recall/'+tag;
 await recall.getByLabel('Recall folder grouping',{exact:true}).selectOption('custom');await recall.getByLabel('Recall custom folder',{exact:true}).fill(tag);
 const png=Buffer.from(await page.evaluate(async()=>{const c=document.createElement('canvas');c.width=8;c.height=8;const x=c.getContext('2d')!;x.fillStyle='lime';x.fillRect(0,0,8,8);const blob=await new Promise<Blob>(r=>c.toBlob(b=>r(b!)));return Array.from(new Uint8Array(await blob.arrayBuffer()));}));
 await test('resident file save then paged timeline opens actual stored PNG',{'RC-18':'partial'},async()=>{await recall.getByLabel('Choose resident media').setInputFiles({name:'resident.png',mimeType:'image/png',buffer:png});await recall.getByRole('status').filter({hasText:'Saved memory →'}).waitFor();await recall.getByRole('button',{name:'Refresh memory timeline',exact:true}).click();await recall.getByRole('list',{name:'Memory timeline'}).getByRole('button').first().click();await recall.getByRole('img',{name:'Saved memory',exact:true}).evaluate(async(i:HTMLImageElement)=>i.decode());});
 await test('UI receipt verification checks the stored pair',{'RC-19':'partial'},async()=>{await recall.getByRole('button',{name:'Verify saved receipt'}).click();await recall.getByRole('status').filter({hasText:'Receipt matches stored bytes:'}).waitFor();});
 await test('local Blob export downloads exact open bytes, no upstream request',{'RC-20':'partial'},async()=>{const before=await(await fetch('http://127.0.0.1:4002/count')).json();const download=page.waitForEvent('download');await recall.getByRole('button',{name:'Export open memory'}).click();const d=await download;assert.deepEqual(readFileSync((await d.path())!),png);assert.deepEqual(await(await fetch('http://127.0.0.1:4002/count')).json(),before);});
 await test('tampered stored receipt is not called verified',{},async()=>{const nodes=(await api('GET','/api/fs?'+new URLSearchParams({op:'list',path}))).nodes;const receipt=nodes.find((n:any)=>n.path.endsWith('.recall.json'));const r=await api('GET','/api/fs?'+new URLSearchParams({op:'read',path:receipt.path}));const content=JSON.parse(r.node.content);content.sha256='0'.repeat(64);await api('POST','/api/fs',{op:'write',path:receipt.path,content:JSON.stringify(content)});await recall.getByRole('button',{name:'Verify saved receipt'}).click();await recall.getByRole('status').filter({hasText:'checksum mismatch'}).waitFor();});
 await test('native clipboard image-transfer experiment records the real permission boundary',{'RC-16':'partial'},async()=>{
  await page.evaluate(()=>{const button=document.createElement('button');button.id='tt104-clipboard-source';button.textContent='Copy authored clipboard image';button.style.cssText='position:fixed;top:0;left:600px;z-index:2147483647';button.onclick=async()=>{try{const c=document.createElement('canvas');c.width=8;c.height=8;c.getContext('2d')!.fillRect(0,0,8,8);const blob=await new Promise<Blob>(r=>c.toBlob(b=>r(b!)));await navigator.clipboard.write([new ClipboardItem({'image/png':blob})]);button.dataset.result='written';}catch(e){button.dataset.result=String(e);}};document.body.append(button);});
  await page.locator('#tt104-clipboard-source').click();await page.waitForFunction(()=>document.querySelector('#tt104-clipboard-source')?.getAttribute('data-result'));const outcome=await page.locator('#tt104-clipboard-source').getAttribute('data-result');writeFileSync('docs/evidence/tt104-clipboard.json',JSON.stringify({outcome,permissionOverridden:false,syntheticClipboardEvent:false,physicalClipboardVerified:false,chromium:browser.version()},null,2));
  if(outcome!=='written'){assert.match(outcome??'',/^NotAllowedError:/);console.log('BOUNDARY: actual headless native clipboard image write denied; positive image-paste delivery remains unverified.');await page.locator('#tt104-clipboard-source').evaluate(e=>e.remove());return;}
  const before=(await api('GET','/api/fs?'+new URLSearchParams({op:'recallPage',path}))).nodes.length;
  await recall.getByRole('region',{name:'Paste or drop resident media'}).focus();await page.keyboard.press('Control+V');await recall.getByRole('status').filter({hasText:'Saved memory →'}).waitFor();
  for(let i=0;i<50;i++){const rows=(await api('GET','/api/fs?'+new URLSearchParams({op:'recallPage',path}))).nodes;if(rows.length>before)break;await page.waitForTimeout(100);}
  const after=(await api('GET','/api/fs?'+new URLSearchParams({op:'recallPage',path}))).nodes;assert.equal(after.length,before+1);const receipt=await api('GET','/api/fs?'+new URLSearchParams({op:'read',path:after[0].path+'.recall.json'}));assert.equal(JSON.parse(receipt.node.content).method,'human-paste-file');await page.locator('#tt104-clipboard-source').evaluate(e=>e.remove());
 });
 await test('native text paste does not become an HTTP download',{},async()=>{await page.evaluate(()=>{const t=document.createElement('textarea');t.id='tt104-text';t.value='http://127.0.0.1:4002/asset';document.body.append(t);t.select();});await page.keyboard.press('Control+C');const before=await(await fetch('http://127.0.0.1:4002/count')).json();await recall.getByRole('region',{name:'Paste or drop resident media'}).focus();await page.keyboard.press('Control+V');await recall.getByRole('status').filter({hasText:'text and links are never fetched'}).waitFor();assert.deepEqual(await(await fetch('http://127.0.0.1:4002/count')).json(),before);await page.locator('#tt104-text').evaluate(e=>e.remove());});
 await test('native webpage-link drag is rejected, never refetched',{'RC-17':'partial'},async()=>{await page.evaluate(()=>{const a=document.createElement('a');a.id='tt104-link';a.textContent='Authored drag source';a.href='http://127.0.0.1:4002/asset';a.draggable=true;a.style.cssText='position:fixed;left:600px;top:10px;z-index:2147483647';document.body.append(a);});const before=await(await fetch('http://127.0.0.1:4002/count')).json();await recall.getByRole('region',{name:'Paste or drop resident media'}).evaluate(region=>region.addEventListener('dragover',e=>{region.setAttribute('data-native-drag',String(e.isTrusted));region.setAttribute('data-native-types',Array.from((e as DragEvent).dataTransfer?.types??[]).join(','));}));await page.locator('#tt104-link').dragTo(recall.getByRole('region',{name:'Paste or drop resident media'}));assert.equal(await recall.getByRole('region',{name:'Paste or drop resident media'}).getAttribute('data-native-drag'),'true');assert.match(await recall.getByRole('region',{name:'Paste or drop resident media'}).getAttribute('data-native-types')??'',/text\/uri-list/);assert.equal(new URL(page.url()).pathname,'/');assert.deepEqual(await(await fetch('http://127.0.0.1:4002/count')).json(),before);await page.locator('#tt104-link').evaluate(e=>e.remove());});
 await recall.getByRole('button',{name:'Browse inside Recall',exact:true}).click();const pane=recall.getByRole('region',{name:'Recall browser',exact:true}),frame=pane.frameLocator('[data-testid=wp-frame]');await frame.getByRole('heading',{name:'Already viewed visual'}).waitFor();await pane.getByLabel('Auto Recall folders',{exact:true}).selectOption('custom');await pane.getByLabel('Auto Recall custom folder',{exact:true}).fill(tag);
 await test('streaming discovery preserves a late first-200 visual after 2005 nonvisual elements',{'RC-21':'partial'},async()=>{await frame.locator('canvas').evaluate((canvas:HTMLCanvasElement)=>{const fragment=document.createDocumentFragment();for(let i=0;i<2005;i++){const node=document.createElement('div');node.hidden=true;node.dataset.tt104='budget';fragment.append(node);}canvas.before(fragment);});const before=(await api('GET','/api/fs?'+new URLSearchParams({op:'recallPage',path}))).nodes.length;await pane.getByRole('button',{name:'Save largest loaded visual'}).click();await pane.getByText('Saved loaded visual →',{exact:false}).waitFor();assert.equal((await api('GET','/api/fs?'+new URLSearchParams({op:'recallPage',path}))).nodes.length,before+1);});
 await test('patch-specific positive: removing nonvisual prefix retains subsequent loaded-pixel saving',{},async()=>{await frame.locator('canvas').evaluate(()=>document.querySelectorAll('[data-tt104="budget"]').forEach(n=>n.remove()));await pane.getByRole('button',{name:'Save largest loaded visual'}).click();await pane.getByText('Saved loaded visual →',{exact:false}).waitFor();});
 await test('Specs exposes original and six added Recall requirements without completion inflation',{},async()=>{const rows=(await api('GET','/api/features')).rows.filter((r:any)=>/^RC-\d\d$/.test(r.code));assert.equal(rows.length,21);assert.ok(rows.every((r:any)=>r.status==='partial'));});
 await page.screenshot({path:'docs/evidence/tt104-memory.png'});
}finally{await browser.close();}
finish();
