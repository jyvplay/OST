import assert from 'node:assert/strict';
import {createHash,randomUUID} from 'node:crypto';
import pg from 'pg';
import {makeHarness} from './harness.mts';
const BASE=process.env.BASE,dsn=process.env.DATABASE_URL;if(!BASE||!dsn||process.env.TT89_DISPOSABLE_DATABASE!=='1'||!new URL(dsn).pathname.endsWith('_test'))throw Error('Exclusive _test target required');
const {test,finish}=makeHarness('tt106-lifecycle'),pool=new pg.Pool({connectionString:dsn}),folder='/Downloads/Recall/life106-'+Date.now();
const post=async(body:unknown)=>{const r=await fetch(BASE+'/api/fs',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify(body)});return {status:r.status,data:await r.json()};};
const pair=(path:string,action='inspect',expected?:unknown)=>post({op:'recallPair',path,action,expected});
const create=async(name=randomUUID())=>{const path=folder+'/'+name+'.png',content=Buffer.from([1,2,3,4]).toString('base64'),receipt=JSON.stringify({version:1,path,bytes:4,mime:'image/png',sha256:createHash('sha256').update(Buffer.from(content,'base64')).digest('hex'),method:'human-selected-file',capturedAt:new Date().toISOString(),source:'https://example.com/',page:'https://example.com/',queryRedacted:true});assert.equal((await post({op:'recallCommit',path,content,mime:'image/png',receipt})).status,200);return path;};
const rows=async(path:string)=>(await pool.query('SELECT path,content,version,trashed,trashed_from FROM vfs_nodes WHERE path=$1 OR path=$2 ORDER BY path',[path,path+'.recall.json'])).rows;
try{
 await fetch(BASE+'/api/settings');for(const path of ['/Downloads','/Downloads/Recall',folder])assert.equal((await post({op:'mkdir',path})).status,200);
 await test('single snapshot returns verified pair identity without media bodies',{'RC-24':'partial'},async()=>{const p=await create(),r=await pair(p);assert.equal(r.status,200);assert.equal(r.data.state,'active');assert.equal(r.data.verified.method,'human-selected-file');assert.ok(r.data.guard.media.id>0);assert.ok(!JSON.stringify(r.data).includes('AQIDBA=='));});
 await test('paired trash removes both active files and both search entries',{'RC-25':'partial'},async()=>{const p=await create(),g=(await pair(p)).data.guard,r=await pair(p,'trash',g);assert.equal(r.status,200);assert.ok((await rows(p)).every(n=>n.trashed&&n.trashed_from===p));assert.equal((await pool.query("SELECT 1 FROM index_docs WHERE source='file' AND ref=ANY($1::text[])",[[p,p+'.recall.json']])).rowCount,0);assert.equal(r.data.guard.media.version,g.media.version+1);});
 await test('undo restores the same unchanged pair, content and search entries',{},async()=>{const p=await create(),before=await rows(p),g=(await pair(p)).data.guard,t=await pair(p,'trash',g),r=await pair(p,'restore',t.data.guard);assert.equal(r.status,200);const after=await rows(p);assert.ok(after.every(n=>!n.trashed&&n.trashed_from===null));assert.deepEqual(after.map(n=>n.content),before.map(n=>n.content));assert.equal((await pool.query("SELECT 1 FROM index_docs WHERE source='file' AND ref=ANY($1::text[])",[[p,p+'.recall.json']])).rowCount,2);});
 await test('stale guard cannot trash edited content',{},async()=>{const p=await create(),g=(await pair(p)).data.guard;await post({op:'write',path:p,content:Buffer.from([4,3,2,1]).toString('base64'),encoding:'base64',mime:'image/png'});assert.equal((await pair(p,'trash',g)).status,409);assert.ok((await rows(p)).every(n=>!n.trashed));});
 await test('stale undo cannot restore a changed trashed receipt',{},async()=>{const p=await create(),g=(await pair(p)).data.guard,t=await pair(p,'trash',g);await pool.query('UPDATE vfs_nodes SET version=version+1 WHERE path=$1',[p+'.recall.json']);assert.equal((await pair(p,'restore',t.data.guard)).status,409);assert.ok((await rows(p)).every(n=>n.trashed));});
 await test('ABA trash/restore cycle invalidates prior undo version',{},async()=>{const p=await create(),a=await pair(p,'trash',(await pair(p)).data.guard),b=await pair(p,'restore',a.data.guard),c=await pair(p,'trash',b.data.guard);assert.equal(c.status,200);assert.equal((await pair(p,'restore',a.data.guard)).status,409);});
 await test('two simultaneous guarded trash calls have exactly one winner',{},async()=>{const p=await create(),g=(await pair(p)).data.guard;const r=await Promise.all([pair(p,'trash',g),pair(p,'trash',g)]);assert.equal(r.filter(n=>n.status===200).length,1);assert.equal(r.filter(n=>n.status===409).length,1);});
 await test('missing receipt refuses without trashing media',{},async()=>{const p=await create();await pool.query('DELETE FROM vfs_nodes WHERE path=$1',[p+'.recall.json']);assert.equal((await pair(p)).status,409);assert.equal((await rows(p))[0].trashed,false);});
 await test('mixed independent Files trash state is not silently repaired',{},async()=>{const p=await create();await post({op:'trash',path:p});assert.equal((await pair(p)).status,409);});
 await test('independently trashed siblings cannot be claimed as paired undo',{},async()=>{const p=await create();await post({op:'trash',path:p});await post({op:'trash',path:p+'.recall.json'});const g=(await pair(p)).data.guard;assert.equal((await pair(p,'restore',g)).status,409);});
 for(const path of ['/','/Private/x.png','/Downloads/Recall/a/../x.png',folder+'/nested/x.png',folder+'/a.recall.json'])await test('invalid lifecycle path '+path,{},async()=>assert.equal((await pair(path)).status,400));
 for(const expected of [null,{},[],{media:{id:0}},'anything'])await test('invalid guard '+JSON.stringify(expected),{},async()=>assert.equal((await pair(folder+'/never.png','trash',expected)).status,400));
 await test('unknown action cannot mutate',{},async()=>{const p=await create();assert.equal((await pair(p,'purge')).status,400);assert.ok((await rows(p)).every(n=>!n.trashed));});
 await test('real journal-trigger failure rolls back pair flags, versions and index deletion',{},async()=>{const p=await create('fail106'),before=await rows(p),g=(await pair(p)).data.guard;await pool.query('CREATE SEQUENCE tt106_hits');await pool.query(`CREATE FUNCTION tt106_fail() RETURNS trigger LANGUAGE plpgsql AS $$ BEGIN IF NEW.op='trash' AND NEW.src LIKE '%/fail106.png.recall.json' THEN PERFORM nextval('tt106_hits'); RAISE EXCEPTION 'real106'; END IF; RETURN NEW; END $$`);await pool.query('CREATE TRIGGER tt106_fail BEFORE INSERT ON file_ops FOR EACH ROW EXECUTE FUNCTION tt106_fail()');try{const r=await pair(p,'trash',g);assert.equal(r.status,400);assert.match(r.data.error,/not acknowledged/);assert.ok(!r.data.error.includes('insert into'));assert.equal((await pool.query('SELECT is_called FROM tt106_hits')).rows[0].is_called,true);assert.deepEqual(await rows(p),before);assert.equal((await pool.query("SELECT 1 FROM index_docs WHERE source='file' AND ref=ANY($1::text[])",[[p,p+'.recall.json']])).rowCount,2);}finally{await pool.query('DROP TRIGGER tt106_fail ON file_ops');await pool.query('DROP FUNCTION tt106_fail()');await pool.query('DROP SEQUENCE tt106_hits');}});
 await test('patch-specific recovery after actual rollback succeeds',{},async()=>{const p=folder+'/fail106.png';assert.equal((await pair(p,'trash',(await pair(p)).data.guard)).status,200);});
}finally{await pool.end();}
finish();
