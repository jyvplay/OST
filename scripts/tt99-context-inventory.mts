/** Reproducible SOURCE inventory. This deliberately does not certify runtime semantics for untested apps. */
import { readFileSync, writeFileSync } from 'node:fs';
import assert from 'node:assert/strict';
import { MODULES } from '../src/lib/registry.ts';
const host = readFileSync('src/components/ModuleHost.tsx','utf8');
const imports = new Map([...host.matchAll(/import (\w+) from "(\.\/modules\/[^\"]+)"/g)].map(m=>[m[1], `src/components/${m[2].slice(2)}.tsx`]));
const components = new Map([...host.matchAll(/case "([^"]+)": return <(\w+)/g)].map(m=>[m[1],m[2]]));
const specialized: Record<string,string> = {
  files: 'FilesPane concise/full/search actions; ancestor-column menus added TT99',
  notes: 'Orbit saved-note open/copy/pin/duplicate/confirmed delete; dirty guards',
  alerts: 'Orbit read/unread/pin/snooze/copy/dismiss; held alert release',
  find: 'Orbit open via actual file metadata, parent folder, copy reference/excerpt; stale-result guard',
  browser: 'Orbit clicked-tab activate/pin/duplicate URL/sleep/copy/close/batch-close',
  editor: 'Native text editing and window fallback; restored Keep/Save/status banner after document load',
  writer: 'Existing spelling context menu; native editable document surface',
};
const newlyExercised = new Set(['files','notes','alerts','find','browser','editor']);
const rows=MODULES.map(m=>{
  const component=components.get(m.id), path=component && imports.get(component); assert.ok(path, `unmapped module ${m.id}`);
  return { id:m.id, title:m.title, source:path, surface:specialized[m.id] ?? 'Window controls fallback; native editing/media/link/canvas retained where applicable. No semantic-object menu certification.', verification:newlyExercised.has(m.id) ? 'Partial TT99 browser evidence; not full Class A' : 'Source inventory only this turn; not runtime certified' };
});
writeFileSync('docs/tt99-context-inventory.json',JSON.stringify({kind:'source-inventory-not-universal-verification',modules:rows},null,2)+'\n');
writeFileSync('docs/TT99-CONTEXT-INVENTORY.md',`# TT99 context-action inventory\n\nGenerated by scripts/tt99-context-inventory.mts. ${rows.length} registered apps. A shared window menu is **not** a semantic menu for every object. No Class A promotion is implied.\n\n| App | Source | Action surface | This-turn evidence |\n|---|---|---|---|\n`+rows.map(r=>`| ${r.title} (${r.id}) | \`${r.source}\` | ${r.surface} | ${r.verification} |`).join('\n')+`\n\n## Shell systems\n\n- Classic desktop: inherited and TT99 extended Orbit/file actions and rectangular selection; browser-tested.\n- Files: list/grid/dual-pane rectangular selection and column ancestor context tested; current-column scrolling uses its own scroll surface.\n- Tabletop: existing cards/piles/wall context actions preserved; **3D marquee not implemented or certified**.\n- Dock/Taskbar: existing app jump menus preserved; not newly audited in every layout.\n- Top/menu bars, launcher, widgets: existing direct controls remain; no universal semantic right-click layer is claimed.\n- Native text, media, canvas and cross-origin documents: not replaced by a synthetic universal clipboard or OS menu.\n`);
console.log(`${rows.length} registered modules mapped to real source files; explicit partial/untested classifications written.`);
