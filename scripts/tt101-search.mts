/** Real HTTP/PostgreSQL and native ID3 bytes, no API interception or fabricated execution. */
import assert from 'node:assert/strict';
import pg from 'pg';
import {deflateSync} from 'node:zlib';
import {makeHarness} from './harness.mts';
import {metadataValues,metadataPage} from '../src/lib/search/metadata.ts';
import {readId3v2} from '../src/lib/meta/audio.ts';
import {PrivacyLayer} from '../src/lib/privacy/layer.ts';
import {createVolume} from '../src/lib/privacy/pcrypt.ts';
if(process.env.TT89_DISPOSABLE_DATABASE!=='1'||!process.env.BASE||!process.env.DATABASE_URL)throw new Error('Explicit disposable DB and BASE required');
const BASE=process.env.BASE,tag='tt101-'+Date.now(),dir='/Documents/'+tag;
const {test,finish}=makeHarness('tt101-search');
async function api(method:string,path:string,body?:unknown){const r=await fetch(BASE+path,{method,headers:{'content-type':'application/json'},body:body?JSON.stringify(body):undefined});const j=await r.json();assert.ok(r.ok,JSON.stringify(j));return j;}
const write=(path:string,content:string,mime='text/plain',encoding='utf8')=>api('POST','/api/fs',{op:'write',path,content,mime,encoding});
const query=(q:string,field='',scope=dir,cursor='')=>api('GET','/api/search?'+new URLSearchParams({q,field,scope,cursor,mode:'metadata'}));
const frame=(id:string,data:Buffer)=>{const h=Buffer.alloc(10);h.write(id);h.writeUInt32BE(data.length,4);return Buffer.concat([h,data]);};
const lyrics='opalbridge sung words in a real stored lyric tag';
const payload=Buffer.concat([frame('USLT',Buffer.concat([Buffer.from([3]),Buffer.from('eng'),Buffer.from([0]),Buffer.from(lyrics)])),frame('TXXX',Buffer.concat([Buffer.from([3]),Buffer.from('transcript\0'),Buffer.from('heliotrope interview passage')])),frame('TPE1',Buffer.concat([Buffer.from([3]),Buffer.from('Indigo Artist')]))]);
const header=Buffer.from([73,68,51,4,0,0,(payload.length>>21)&127,(payload.length>>14)&127,(payload.length>>7)&127,payload.length&127]);
const id3=Buffer.concat([header,payload]);
await api('POST','/api/fs',{op:'mkdir',path:dir});
await write(dir+'/song.mp3',id3.toString('base64'),'audio/mpeg','base64');
await write(dir+'/details.json',JSON.stringify({transcript:'x'.repeat(55000)+' celadon dialogue',audio:{lyrics:'vermilion refrain',rating:0,published:false,unknown:{'percent%_':'literal%_needle'}}}),'application/json');
await write(dir+'/captions.vtt','WEBVTT\n\n00:00.000 --> 00:01.000\nquartzcaption spoken sentence','text/vtt');
await write(dir+'/words.lrc','[00:01.00]saffronlrc melody','text/plain');
await write(dir+'/big.txt','z'.repeat(262145)+' beyondbudget');
await test('ID3 USLT lyrics decode from actual frame bytes',{},async()=>{assert.equal((await readId3v2(id3))?.tags['lyrics.eng.'],lyrics);});
await test('ID3 TXXX arbitrary text is retained instead of silently ignored',{},async()=>{assert.equal((await readId3v2(id3))?.tags['custom.transcript'],'heliotrope interview passage');});
await test('truncated frame is refused with a warning, not indexed as complete lyrics',{},async()=>{const r=await readId3v2(id3.subarray(0,30));assert.ok(r?.warnings.some(x=>x.includes('truncated')));assert.equal(r?.tags['lyrics.eng.'],undefined);});
await test('unknown ID3 text frame is preserved by its frame identifier',{},async()=>{const f=frame('TZZZ',Buffer.from([3,65,66,67]));const h=Buffer.from(header);h[6]=h[7]=h[8]=0;h[9]=f.length;assert.equal((await readId3v2(Buffer.concat([h,f])))?.tags['id3.TZZZ'],'ABC');});
await test('independent MIT music-metadata parser agrees on the real ID3 lyrics and custom transcript',{},async()=>{
 const external=await import('/home/user/tools/node_modules/music-metadata/lib/index.js');const parsed=await external.parseBuffer(id3,{mimeType:'audio/mpeg'},{duration:false});const native=parsed.native['ID3v2.4'];
 const uslt=native.find((x:{id:string})=>x.id==='USLT');assert.equal(uslt.value.text,lyrics);assert.ok(native.some((x:{id:string;value:unknown})=>x.id.includes('TXXX')&&JSON.stringify(x.value).includes('heliotrope')));
});
await test('UTF-16 ID3v2.3 lyrics agree with the independent parser',{},async()=>{const word='ατέρμων';const data=Buffer.concat([Buffer.from([1]),Buffer.from('ell'),Buffer.from([255,254]),Buffer.from('draft','utf16le'),Buffer.from([0,0,255,254]),Buffer.from(word,'utf16le')]);const f=frame('USLT',data),h=Buffer.from(header);h[3]=3;h[6]=h[7]=h[8]=0;h[9]=f.length;const bytes=Buffer.concat([h,f]);assert.equal((await readId3v2(bytes))?.tags['lyrics.ell.draft'],word);const external=await import('/home/user/tools/node_modules/music-metadata/lib/index.js');const parsed=await external.parseBuffer(bytes,{mimeType:'audio/mpeg'},{duration:false});assert.equal(parsed.native['ID3v2.3'].find((x:{id:string})=>x.id==='USLT').value.text,word);});
await test('compressed ID3 metadata is explicitly refused without inflation',{},async()=>{const plain=Buffer.from([3,...Buffer.from('eng'),0,...Buffer.from('compressedsecret'.repeat(1000))]);const size=Buffer.alloc(4);size.writeUInt32BE(plain.length);const f=frame('USLT',Buffer.concat([size,deflateSync(plain)]));f.writeUInt16BE(0x80,8);const h=Buffer.from(header);h[3]=3;h[6]=h[7]=0;h[8]=(f.length>>7)&127;h[9]=f.length&127;const r=await metadataPage([{path:'/x.mp3',name:'x.mp3',encoding:'base64',mime:'audio/mpeg',content:Buffer.concat([h,f]).toString('base64')}],{q:'compressedsecret',field:'lyrics',cursor:''});assert.equal(r.hits.length,0);assert.ok(r.warnings.some(x=>x.reasons.some(y=>y.includes('decompression failed'))));});
await test('non-file source filters are explicitly rejected rather than ignored',{},async()=>{const r=await fetch(BASE+'/api/search?mode=metadata&q=x&source=note');assert.equal(r.status,400);});
await test('embedded lyrics are found on the actual stored audio file with provenance',{},async()=>{const r=await query('opalbridge','lyrics');assert.equal(r.hits[0]?.ref,dir+'/song.mp3');assert.ok(r.hits[0].matchedFields.some((x:{field:string})=>x.field.includes('lyrics')));});
await test('arbitrary custom transcript in embedded audio is searchable',{},async()=>{assert.equal((await query('heliotrope','transcript')).hits[0]?.ref,dir+'/song.mp3');});
await test('artist header is searchable without pretending to decode the audio stream',{},async()=>{assert.equal((await query('Indigo','artist')).hits[0]?.ref,dir+'/song.mp3');});
await test('stored JSON transcript beyond legacy 50000-character limit is found',{},async()=>{assert.equal((await api('GET','/api/search?'+new URLSearchParams({q:'celadon',scope:dir}))).hits.length,0,'modal shortcut: the old index misses this real late value');assert.equal((await query('celadon','transcript')).hits[0]?.ref,dir+'/details.json');});
await test('nested arbitrary metadata and unknown keys remain searchable',{},async()=>{assert.equal((await query('literal%_needle','percent%_')).hits.length,1);});
await test('zero and false scalar values are searchable, not dropped as falsy',{},async()=>{assert.equal((await query('0','rating')).hits.length,1);assert.equal((await query('false','published')).hits.length,1);});
await test('VTT transcript text is searchable',{},async()=>{assert.equal((await query('quartzcaption')).hits[0]?.ref,dir+'/captions.vtt');});
await test('LRC lyric text is searchable',{},async()=>{assert.equal((await query('saffronlrc')).hits[0]?.ref,dir+'/words.lrc');});
await test('stored SHA metadata can be found without textual content',{},async()=>{const n=(await api('GET','/api/fs?op=stat&path='+encodeURIComponent(dir+'/song.mp3'))).node;assert.equal((await query(n.sha256,'sha256')).hits.length,1);});
await test('field filtering does not silently fall back to another field',{},async()=>{assert.equal((await query('Indigo','lyrics')).hits.length,0);});
await test('Unicode compatibility normalization matches full-width text',{},async()=>{await write(dir+'/unicode.txt','ＦｕｓｉｏｎUnicode');assert.equal((await query('FusionUnicode')).hits.length,1);});
await test('large content is honestly skipped and reported',{},async()=>{const r=await query('beyondbudget');assert.equal(r.hits.length,0);assert.ok(r.truncatedFiles>=1);assert.ok(r.warnings.some((x:{ref:string})=>x.ref.endsWith('/big.txt')));});
await test('path boundaries prevent sibling-prefix scope leakage',{},async()=>{await write(dir+'-sibling/other.txt','saffronlrc');assert.equal((await query('saffronlrc')).hits.length,1);});
await test('literal SQL metacharacters and injection-shaped query do not become operators',{},async()=>{assert.equal((await query("' OR 1=1 --")).hits.length,0);});
await test('pagination reaches a held-out match after the first bounded page',{},async()=>{for(let i=0;i<36;i++)await write(dir+`/page-${String(i).padStart(2,'0')}.txt`,i===35?'heldoutpagination':'other');let cursor='',found=false,pages=0;do{const r=await query('heldoutpagination','',dir,cursor);found ||=r.hits.some((h:{ref:string})=>h.ref.endsWith('page-35.txt'));cursor=r.nextCursor??'';pages++;assert.ok(pages<=4);}while(cursor);assert.ok(found&&pages>=2);});
await test('private plaintext is excluded even when calling host endpoint directly',{},async()=>{const path='/Private/'+tag+'.json';try{await write(path,'privatesecrettext','application/json');assert.equal((await query('privatesecrettext','','/')).hits.length,0);}finally{await api('POST','/api/fs',{op:'purge',path});}});
await test('current exclusions apply in both metadata and legacy text modes',{},async()=>{const old=(await api('GET','/api/settings')).rows.find((x:{key:string})=>x.key==='search.excludes').value;try{await api('PUT','/api/settings',{key:'search.excludes',value:dir});assert.equal((await query('opalbridge')).hits.length,0);assert.equal((await api('GET','/api/search?q=quartzcaption&scope='+encodeURIComponent(dir))).hits.length,0);}finally{await api('PUT','/api/settings',{key:'search.excludes',value:old});}});
await test('live metadata sees updated values and does not return obsolete fields',{},async()=>{await write(dir+'/live.json','{"tag":"oldvaluewitness"}','application/json');await write(dir+'/live.json','{"tag":"newvaluewitness"}','application/json');assert.equal((await query('oldvaluewitness')).hits.length,0);let r=await query('newvaluewitness');while(!r.hits.length&&r.nextCursor)r=await query('newvaluewitness','',dir,r.nextCursor);assert.equal(r.hits.length,1);});
await test('deep JSON is truncated explicitly without stack overflow',{},async()=>{let o:unknown='deepsecret';for(let i=0;i<30;i++)o={next:o};const r=await metadataValues({path:'/x',name:'x.json',mime:'application/json',encoding:'utf8',content:JSON.stringify(o)});assert.ok(r.truncated);});
await test('compressed or unsupported binary is not claimed fully inspected',{},async()=>{const r=await metadataValues({path:'/x',name:'x.zip',mime:'application/zip',encoding:'base64',content:Buffer.from('PKxxx').toString('base64')});assert.ok(r.warnings.length);});
await test('invalid query bounds are rejected by the real endpoint',{},async()=>{const r=await fetch(BASE+'/api/search?mode=metadata&q='+('x'.repeat(513)));assert.equal(r.status,400);});
// Real privacy transport over the actual server, not a fabricated fetch response.
let revokeOnRead=false;const requests:string[]=[];const layer=new PrivacyLayer(async(input,init)=>{requests.push(String(input));const response=await fetch(new URL(String(input),BASE),init);if(revokeOnRead&&String(input).includes('op=read'))layer.keys=null;return response;});
const {keys}=await createVolume('tt101-real-volume');layer.keys=keys;
const privatePath='/Private/'+tag+'-owned.json';
await layer.handle('/api/fs',{method:'POST',body:JSON.stringify({op:'write',path:privatePath,content:'{"lyrics":"encryptedlyricwitness"}',mime:'application/json'})});
await test('unlocked private metadata search runs locally and query text never reaches HTTP',{},async()=>{requests.length=0;const r=await layer.handle('/api/search?'+new URLSearchParams({mode:'metadata',q:'encryptedlyricwitness',scope:'/Private'}));const j=await r.json();assert.ok(j.ok,JSON.stringify(j));assert.equal(j.hostQueried,false);assert.ok(j.hits.some((h:{ref:string})=>h.ref===privatePath));assert.ok(!requests.some(x=>x.includes('encryptedlyricwitness')||x.includes('/api/search')));});
await test('private non-file source filters are rejected locally without forwarding query text',{},async()=>{requests.length=0;const r=await layer.handle('/api/search?mode=metadata&q=encryptedlyricwitness&scope=/Private&source=note');assert.equal(r.status,400);assert.equal(requests.length,0);});
await test('real encrypted files paginate locally and do not leak private query text',{},async()=>{const dir='/Private/'+tag+'-pages';for(let i=0;i<35;i++){const r=await layer.handle('/api/fs',{method:'POST',body:JSON.stringify({op:'write',path:dir+'/'+String(i).padStart(2,'0')+'.json',content:JSON.stringify({transcript:i===34?'privatepagewitness':'ordinary'}),mime:'application/json'})});assert.ok(r.ok,await r.clone().text());}requests.length=0;let cursor='',found=false,pages=0;do{const r=await layer.handle('/api/search?'+new URLSearchParams({mode:'metadata',q:'privatepagewitness',scope:dir,cursor}));const j=await r.json();assert.ok(j.ok,JSON.stringify(j));assert.ok(j.scanned<=32);found ||=j.hits.some((x:{ref:string})=>x.ref.endsWith('34.json'));cursor=j.nextCursor??'';pages++;assert.ok(pages<4);}while(cursor);assert.ok(found&&pages===2);assert.ok(!requests.some(x=>x.includes('privatepagewitness')||x.includes('/api/search')));});
await test('pure page engine cannot admit a 33rd result even with a 33rd supplied record',{},async()=>{const r=await metadataPage(Array.from({length:33},(_,i)=>({path:'/x/'+i,name:'x',mime:'text/plain',encoding:'utf8',content:'limitwitness'})),{q:'limitwitness',field:'',cursor:''});assert.equal(r.hits.length,32);assert.equal(r.scanned,32);});
await test('lock during a real private file read discards the pending metadata result',{},async()=>{revokeOnRead=true;try{const r=await layer.handle('/api/search?mode=metadata&q=encryptedlyricwitness&scope=/Private');assert.equal(r.status,423);assert.equal((await r.json()).hits,undefined);}finally{revokeOnRead=false;}});
await test('locked private metadata fails closed without a host query',{},async()=>{layer.keys=null;requests.length=0;const r=await layer.handle('/api/search?mode=metadata&q=encryptedlyricwitness&scope=/Private');assert.equal(r.status,423);assert.equal(requests.length,0);});
await test('amnesic metadata searches actual RAM writes without a host query',{},async()=>{layer.amnesic=true;await layer.handle('/api/fs',{method:'POST',body:JSON.stringify({op:'write',path:'/Documents/ram.json',content:'{"transcript":"ramtranscriptwitness"}',mime:'application/json'})});requests.length=0;const r=await layer.handle('/api/search?mode=metadata&q=ramtranscriptwitness');const j=await r.json();assert.equal(j.hits[0]?.ref,'/Documents/ram.json');assert.equal(requests.length,0);});
const db=new pg.Client({connectionString:process.env.DATABASE_URL});await db.connect();
await test('private metadata never appears in PostgreSQL plaintext',{},async()=>{const r=await db.query("select count(*)::int n from vfs_nodes where content like '%encryptedlyricwitness%' or path like $1",['%'+tag+'-owned%']);assert.equal(r.rows[0].n,0);});
await db.end();finish();
