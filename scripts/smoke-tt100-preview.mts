/** Real browser + real APIs on a separate, explicitly named preview DB. Does not capture or grant native permissions. */
import assert from 'node:assert/strict';
import {writeFileSync} from 'node:fs';
import pg from 'pg';
import {launchChromium} from './browser-launch.mts';
if(process.env.TT100_PREVIEW_SMOKE!=='1'||!process.env.BASE||!process.env.DATABASE_URL||new URL(process.env.DATABASE_URL).pathname!=='/tt100_preview')throw new Error('Explicit TT100_PREVIEW_SMOKE=1, BASE and tt100_preview DATABASE_URL required');
const BASE=process.env.BASE,checks:string[]=[];
const db=new pg.Client({connectionString:process.env.DATABASE_URL});await db.connect();
async function api(method:string,path:string,body?:unknown){const r=await fetch(BASE+path,{method,headers:{'content-type':'application/json'},body:body?JSON.stringify(body):undefined});assert.ok(r.ok,`${method} ${path}: ${r.status}`);return r.json();}
await api('GET','/api/bootstrap');
assert.equal(Number((await db.query("select count(*) n from vfs_nodes where path like '%tt100-%' or path like '%e2e55-%' or path like '/Downloads/Recall/%'")).rows[0].n),0);checks.push('separate PostgreSQL preview has no Recall recordings or exclusive test fixtures');
const title='Recall field guide';if(!(await api('GET','/api/notes')).rows.some((n:{title:string})=>n.title===title))await api('POST','/api/notes',{title,body:'Recall has three bounded methods: original response bytes, authorized live stream encoding, and PNG raster snapshots.\n\nTry a Fusion source: open Image Editor or play an audio file in Media; open Recall; Refresh Fusion sources; choose the real element; capture or record. Canvas has no audio.\n\nNative display/tab sharing needs your browser permission each time. Shared system audio and the experimental local-file sink have not been physically verified here. No DRM or opaque-frame bypass is promised.\n\nIn a private-proxy Browser tab, Auto Recall is off until you opt in. It archives exposed same-origin HTTP media, not every site or network stream.\n\nVFS recordings are unencrypted in /Downloads/Recall, maximum 8 MiB; amnesic server writes are refused. Receipts hash bytes and redact URL query/fragment, not every sensitive path/title.\n\nThe 217-check production gate is bounded evidence, not all-app Class A certification.',tags:'guide'});
const old=await api('GET','/api/state?id=default');await api('PUT','/api/state',{id:'default',revision:(old.row?.revision??1)+1000,state:{...old.row?.state,windows:[],focus:null}});
const browser=await launchChromium();try{
 const page=await browser.newPage({viewport:{width:1440,height:1000}}),errors:string[]=[];page.on('pageerror',e=>errors.push(e.message));
 await page.goto(BASE+'/?open=recall');const recall=page.getByTestId('recall');await recall.getByRole('heading',{name:/Recall.*idle/}).waitFor();for(const n of ['1 · Original bytes','2 · Authorized live','3 · PNG raster'])await recall.getByRole('heading',{name:new RegExp(n)}).waitFor();checks.push('actual Recall module opens with three real method sections and idle state');
 assert.equal(await recall.getByLabel('Recall capture source').inputValue(),'display');assert.equal(await recall.getByRole('button',{name:'Start authorized recording',exact:true}).isEnabled(),true);assert.equal(await recall.locator('li[data-phase=saved]').count(),0);checks.push('no recording or permission grant is simulated; native source remains user controlled');
 const session=await api('POST','/api/wp-session',{});try{const denied=await fetch(BASE+`/api/wp/s/${encodeURIComponent(session.sid)}/__raw?u=${encodeURIComponent('http://127.0.0.1:4001/image.png')}`);assert.equal(denied.status,502);assert.match(await denied.text(),/Only the standard web ports/);const privateAddress=await fetch(BASE+`/api/wp/s/${encodeURIComponent(session.sid)}/__raw?u=${encodeURIComponent('http://127.0.0.1/image.png')}`);assert.equal(privateAddress.status,502);assert.match(await privateAddress.text(),/private or local network/);}finally{await fetch(BASE+`/api/wp-session?sid=${encodeURIComponent(session.sid)}`,{method:'DELETE'});}checks.push('production proxy rejects loopback without the test-only exception');
 await page.screenshot({path:'docs/evidence/tt100-preview.png'});assert.deepEqual(errors,[]);checks.push('actual screenshot captured with no uncaught page errors');
 writeFileSync('docs/evidence/tt100-preview-smoke.json',JSON.stringify({pass:true,database:'tt100_preview',checks,screenshot:'tt100-preview.png'},null,2)+'\n');console.log('Preview smoke: '+checks.length+' checks passed.');
}finally{await browser.close();await db.end();}
