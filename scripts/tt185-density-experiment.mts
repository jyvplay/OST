import assert from 'node:assert/strict';
import {disposableShell} from './tt132-fixture.mts';
const fx=await disposableShell();const dir=`/Documents/tt185-density-${Date.now()}`;
try{
 await fx.api('POST','/api/fs',{op:'mkdir',path:dir});const cur=await fx.api('GET','/api/state?id=default');
 await fx.api('PUT','/api/state',{id:'default',revision:Number(cur.row.revision)+1000,state:{windows:[{id:'w1',module:'files',title:'files',x:20,y:16,w:1440,h:960,z:10,workspace:1,props:{path:dir}}],focus:'w1',workspaces:[{id:1,name:'Main'}],activeWorkspace:1,nextZ:30}});
 const ctx=await fx.context({viewport:{width:1500,height:1040}}),page=await ctx.newPage();
 async function measure(want:number){await fx.ready(page,'files');await page.locator(`[data-cwd="${dir}"]`).first().waitFor();await page.waitForFunction(n=>document.querySelectorAll('[data-win-id="w1"] [role="option"][data-path]').length===n,want);return page.locator('[data-win-id="w1"]').evaluate(root=>{let words=0,rowWords=0;const w=document.createTreeWalker(root,NodeFilter.SHOW_TEXT);let n:Node|null;while((n=w.nextNode())){const p=n.parentElement;if(!p||p.closest('details:not([open])'))continue;const r=p.getBoundingClientRect(),s=getComputedStyle(p);if(!r.width||!r.height||s.visibility==='hidden'||s.display==='none')continue;const count=(n.textContent||'').trim().split(/\s+/).filter(Boolean).length;words+=count;if(p.closest('[role="option"][data-path]'))rowWords+=count;}const list=root.querySelector('[data-testid="files-listing"]')!.getBoundingClientRect();const rows=[...root.querySelectorAll('[role="option"][data-path]')];return {words,rowWords,rows:rows.length,fullyClippedRows:rows.filter(e=>{const r=e.getBoundingClientRect();return r.bottom<=list.top||r.top>=list.bottom}).length};});}
 const empty=await measure(0);for(let i=0;i<30;i++)await fx.api('POST','/api/fs',{op:'write',path:`${dir}/sample-${String(i).padStart(2,'0')}.txt`,content:'fixture'});
 const populated=await measure(30);assert.equal(empty.rows,0);assert.equal(populated.rows,30);assert.ok(populated.fullyClippedRows>0,'requires clipped rows');assert.ok(populated.words>empty.words,'populated listing should affect the legacy count');if(process.env.TT185_SCREENSHOT)await page.screenshot({path:process.env.TT185_SCREENSHOT});console.log(JSON.stringify({empty,populated},null,2));await ctx.close();
}finally{await fx.api('POST','/api/fs',{op:'purge',path:dir});await fx.close();}
